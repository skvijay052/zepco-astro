---
import Icon from './Icon.astro';
import Link from './Link.astro';
import { SOLUTIONS } from '../data/homepage';
---
<section id="solutions" class="section-solutions py-28" style={{ background: "var(--color-navy-950)" }}>
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-8" style={{ background: "var(--color-gold-500)" }} />
          <span class="text-[10px] tracking-[0.3em] uppercase" style={{ color: "var(--color-gold-500)" }}>Products</span>
        </div>
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
          <h2 class="font-display font-bold uppercase text-5xl leading-tight" style={{ letterSpacing: "0.02em" }}>
            Featured<br />Solutions
          </h2>
          <p class="text-sm tracking-widest uppercase font-medium" style={{ color: "var(--color-gold-500)" }}>
            Solutions that Power Innovation
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px" style={{ background: "rgba(196,154,46,0.1)" }}>
          {SOLUTIONS.map((sol) => (
            <Link id={sol.id} href={sol.href}
              class="relative overflow-hidden block group"
              style={{ aspectRatio: "4/3" }}>
              <img
                src={`/images/${sol.img}-450.jpg`} width="600" height="450" loading="lazy" decoding="async"
                alt={sol.title}
                class="w-full h-full object-cover transition-transform duration-700"
                style={{ transform: "scale(1)", filter: "brightness(0.35) saturate(0.2)" }}
              />
              <div class="absolute inset-0 transition-opacity duration-300" style={{ background: "linear-gradient(to top, rgba(3,9,26,0.95) 0%, rgba(3,9,26,0.3) 60%, transparent 100%)" }} />
              <div class="absolute inset-0 p-6 flex flex-col justify-end">
                <h3 class="font-display font-bold uppercase text-xl leading-tight mb-2" style={{ letterSpacing: "0.04em" }}>
                  {sol.title}
                </h3>
                <div class="flex items-center gap-2 text-[10px] tracking-widest uppercase font-medium transition-colors duration-200"
                  style={{ color: "rgba(196,154,46,0.5)" }}>
                  View Details
                  <Icon class="w-3.5 h-3.5" />
                </div>
              </div>
            </Link>
          ))}
        </div>
      </div>
    </section>
