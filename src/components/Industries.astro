                {ind.icon === "industrial" && <svg class="industry-icon" viewBox="11 243 1513 615" fill="currentColor"><path d="M891,664 890,786 906,786 922,779 934,760 934,691 929,679 918,669Z M632,664 610,673 602,685 600,759 605,771 615,781 628,786 644,786 645,667Z M665,650 657,669 657,796 675,834 701,846 834,846 867,826 877,802 877,665 863,644 690,637Z M760,659 790,662 821,678 843,703 854,739 851,769 833,802 812,820 776,832 740,828 714,814 693,791 681,756 685,718 700,692 726,670Z M752,675 722,689 705,708 695,736 696,761 709,789 727,806 754,817 781,817 808,806 831,781 840,752 838,728 827,704 810,687 783,675Z M756,687 779,687 802,697 819,715 827,738 825,763 815,782 797,798 776,805 754,804 733,795 716,777 708,756 708,736 718,712 736,695Z M761,701 746,706 731,719 723,736 722,749 729,770 740,782 756,790 773,791 792,784 803,774 811,760 813,742 808,725 794,709 774,701Z M764,732 772,732 781,738 783,742 782,755 777,761 770,764 765,764 758,761 754,757 751,749 753,740 759,734Z"/></svg>}
                {ind.icon === "unmanned" && <svg class="industry-icon" viewBox="311 48 917 928" fill="currentColor"><path d="M998,807 973,771 926,813 868,831 769,894 626,816 592,781 548,821 652,904 769,964 903,889Z M637,649 600,705 596,739 603,767 625,796 649,810 686,814 713,806 733,792 753,762 758,722 751,697 716,649Z M323,652 362,701 415,702 462,637 551,636 593,685 630,636 721,635 781,686 823,634 914,634 967,713 1017,634 1108,633 1159,713 1212,631 926,559 596,562 579,535 466,536 459,564 382,566Z M928,283 824,194 699,199 602,301 605,438 622,297 702,216 761,202 762,234 656,300 656,430 653,340 694,273 762,248 689,344 711,407 717,317 761,296 773,329 773,297 807,295 773,248 834,257 774,235 774,202 860,232 801,352Z M1152,200 770,60 384,200 407,549 466,520 443,248 768,136 1091,248 1089,443 1149,436Z"/></svg>}
                {ind.icon === "mobility" && <svg class="industry-icon" viewBox="236 218 1063 1021" fill="currentColor"><path d="M376,325 347,477 248,483 256,583 347,578 347,717 248,723 256,823 347,818 347,957 255,952 248,1051 347,1058 367,1198 1159,1210 1188,1058 1287,1053 1279,952 1188,957 1188,818 1287,813 1279,712 1188,717 1188,578 1280,583 1287,484 1188,477 1168,337 952,308 936,230 843,234 835,308 700,308 689,232 599,230 583,308Z M825,463 789,693 943,695 695,1075 734,806 592,805Z"/></svg>}
