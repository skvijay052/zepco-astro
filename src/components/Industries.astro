              </div>
              <h3 class="font-display font-bold uppercase text-2xl mb-3 leading-tight" style={{ letterSpacing: "0.04em" }}>{ind.title}</h3>
              <p class="text-sm leading-relaxed font-light max-w-sm mx-auto" style={{ color: "var(--color-slate-blue)" }}>{ind.desc}</p>
              <div class="mt-6 h-px transition-all duration-300 mx-auto" style={{ background: "transparent", width: "0px" }} />
            </div>
          ))}
        </div>
      </div>
    </section>

<script>
  const industries = document.querySelector('.section-industries') as HTMLElement | null;
  if (industries) {
    const cards = Array.from(industries.querySelectorAll('.industry-card')) as HTMLElement[];
    const backdrops = Array.from(industries.querySelectorAll('.industry-backdrop')) as HTMLElement[];

    const setActive = (id: string | null) => {
      backdrops.forEach((backdrop) => {
        const isActive = id !== null && backdrop.dataset.backdrop === id;
        backdrop.classList.toggle('active', isActive);
      });
    };

    const preload = (backdrop: HTMLElement) => {
      const image = backdrop.querySelector('.industry-photo') as HTMLElement | null;
      const src = image?.dataset.src;
      if (image && src && !image.style.backgroundImage) {
        image.style.backgroundImage = `url("${src}")`;
        image.style.backgroundPosition = 'center';
      }
    };

    backdrops.forEach(preload);

    cards.forEach((card) => {
      const activate = () => setActive(card.id);
      const deactivate = () => setActive(null);
      card.addEventListener('mouseenter', activate);
      card.addEventListener('mouseleave', deactivate);
      card.addEventListener('focusin', activate);
      card.addEventListener('focusout', () => {
        if (!card.contains(document.activeElement)) deactivate();
      });
      card.addEventListener('touchstart', activate, { passive: true });
    });

    setActive(null);
  }
</script>

<style>
  .section-industries { background: #04091E; }
  .industry-glow-blue { background: radial-gradient(ellipse at center, rgba(30,60,120,.22) 0%, transparent 70%); }
  .industry-glow-gold { background: radial-gradient(ellipse at center, rgba(196,154,46,.09) 0%, transparent 65%); }
  .industry-haze { background: radial-gradient(ellipse at center, rgba(15,35,80,.3) 0%, transparent 70%); }
  .industry-horizon { background: linear-gradient(to right, transparent, rgba(196,154,46,.12), transparent); }
  .industry-backdrop { opacity: 0; transition: opacity .55s ease; z-index: 0; }
  .industry-backdrop.active { opacity: .16; }
  .industry-photo { background-size: cover; background-position: center; filter: saturate(.35) brightness(1.45); transform: scale(1.04); }
  .industry-vignette { background: radial-gradient(ellipse at center, transparent 12%, rgba(4,9,30,.72) 78%, #04091E 100%); }
  .industry-card { position: relative; z-index: 2; background: rgba(4,10,28,.54); }
  .industry-card:is(:hover, :focus-within) { background: rgba(12,27,56,.78); }
  .industry-icon-wrap { width: 84px; height: 72px; color: rgba(196,154,46,0.72); }
  .industry-icon { width: 84px; height: 72px; display: block; transition: color .3s ease, transform .3s ease; }
  .industry-card:is(:hover, :focus-within) .industry-icon { color: var(--color-gold-500); transform: translateY(-2px); }
  .industry-card:is(:hover, :focus-within) > div:last-child { width: 40px !important; background: var(--color-gold-500) !important; }

  /* Light mode: keep the same hover mapping, but make the selected industry image clearly visible. */
  html[data-theme='light'] .section-industries { background: #eef2f7; }
  html[data-theme='light'] .industry-backdrop.active { opacity: .32; }
  html[data-theme='light'] .industry-photo { filter: saturate(.62) brightness(1.08) contrast(.98); }
  html[data-theme='light'] .industry-vignette {
    background: radial-gradient(ellipse at center, rgba(255,255,255,.02) 8%, rgba(238,242,247,.18) 58%, rgba(238,242,247,.62) 100%);
  }
  html[data-theme='light'] .industry-card { background: rgba(255,255,255,.62); }
  html[data-theme='light'] .industry-card:is(:hover, :focus-within) { background: rgba(255,255,255,.78); }

  @media (prefers-reduced-motion: reduce) {
    .industry-backdrop { transition: none; }
    .industry-photo { transform: none; }
  }
</style>
