---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import NavigationItems from './NavigationItems.astro';
import { navigation } from '../data/site';
---
<header class="site-header fixed top-0 left-0 right-0 z-50">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-16">
    <a href="/" aria-label="Zepco Technologies home" class="shrink-0"><Brand /></a>
    <nav aria-label="Main navigation" class="desktop-navigation">
      <NavigationItems items={navigation} variant="desktop" />
    </nav>
    <div class="header-actions items-center gap-3">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
        <span class="theme-icon theme-icon-moon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 14.7A8.5 8.5 0 0 1 9.3 3a8.5 8.5 0 1 0 11.7 11.7Z"/></svg></span><span class="theme-toggle-label">Dark</span>
      </button>
      <a href="#contact" data-open-engineer class="header-cta items-center px-5 py-2 text-xs tracking-widest uppercase font-semibold transition-all duration-200">Talk to an Engineer</a>
    </div>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" hidden>
      <span class="menu-open-icon"><Icon name="menu" /></span>
      <span class="menu-close-icon" hidden><Icon name="close" /></span>
    </button>
  </div>
  <nav id="mobile-navigation" aria-label="Mobile navigation" class="mobile-navigation px-6 pb-6">
    <NavigationItems items={navigation} variant="mobile" />
    <button class="theme-toggle mobile-theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
      <span class="theme-icon theme-icon-moon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 14.7A8.5 8.5 0 0 1 9.3 3a8.5 8.5 0 1 0 11.7 11.7Z"/></svg></span><span class="theme-toggle-label">Dark mode</span>
    </button>
    <a class="mobile-cta text-xs tracking-widest uppercase font-semibold" href="#contact" data-open-engineer>Talk to an Engineer</a>
  </nav>
</header>
<script>
  const header = document.querySelector('.site-header') as HTMLElement | null;
  const toggle = header?.querySelector('.menu-toggle') as HTMLButtonElement | null;
  const menu = header?.querySelector('#mobile-navigation') as HTMLElement | null;
  const openIcon = toggle?.querySelector('.menu-open-icon') as HTMLElement | null;
  const closeIcon = toggle?.querySelector('.menu-close-icon') as HTMLElement | null;
  const groups = Array.from(header?.querySelectorAll('.navigation-group') ?? []) as HTMLDetailsElement[];
  const themeToggles = Array.from(header?.querySelectorAll('.theme-toggle') ?? []) as HTMLButtonElement[];
  const desktop = window.matchMedia('(min-width: 1200px)');
  const hoverAvailable = window.matchMedia('(hover: hover) and (pointer: fine)');
  const root = document.documentElement;

  const setTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    try { localStorage.setItem('zepco-theme', theme); } catch {}
    themeToggles.forEach((button) => {
      const dark = theme === 'dark';
      button.setAttribute('aria-pressed', String(dark));
      button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      const label = button.querySelector('.theme-toggle-label') as HTMLElement | null;
      if (label) label.textContent = dark ? (button.classList.contains('mobile-theme-toggle') ? 'Light mode' : 'Light') : (button.classList.contains('mobile-theme-toggle') ? 'Dark mode' : 'Dark');
      const icon = button.querySelector('.theme-icon') as HTMLElement | null;
      if (icon) { icon.classList.toggle('theme-icon-sun', dark); icon.classList.toggle('theme-icon-moon', !dark); icon.innerHTML = dark ? '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>' : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 14.7A8.5 8.5 0 0 1 9.3 3a8.5 8.5 0 1 0 11.7 11.7Z"></path></svg>'; }
    });
    const metaTheme = document.querySelector('meta[name="theme-color"]') as HTMLMetaElement | null;
    if (metaTheme) metaTheme.content = theme === 'dark' ? '#03091A' : '#FFFFFF';
  };

  themeToggles.forEach((button) => {
    button.addEventListener('click', () => {
      setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
    });
  });
  setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

  if (header && toggle && menu && openIcon && closeIcon) {
    const closeGroups = () => groups.forEach((group) => { group.open = false; });
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      menu.hidden = !open;
      openIcon.hidden = open;
      closeIcon.hidden = !open;
      if (!open) closeGroups();
    };
    header.classList.add('enhanced');
    toggle.hidden = false;
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    groups.forEach((group) => {
      group.addEventListener('pointerenter', () => {
        if (desktop.matches && hoverAvailable.matches) group.open = true;
      });
      group.addEventListener('pointerleave', () => {
        if (desktop.matches && !group.contains(document.activeElement)) group.open = false;
      });
      group.addEventListener('focusout', () => queueMicrotask(() => {
        if (desktop.matches && !group.contains(document.activeElement) && !group.matches(':hover')) group.open = false;
      }));
      group.addEventListener('toggle', () => {
        if (group.open) {
          groups.forEach((other) => {
            if (other !== group && other.closest('nav') === group.closest('nav')) other.open = false;
          });
        }
      });
    });
    header.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest('a') as HTMLAnchorElement | null;
      if (!link) return;
      setOpen(false);
      // Keep keyboard focus in the destination content after collapsing navigation.
      if (link.hash) {
        const target = document.getElementById(link.hash.slice(1));
        if (target) {
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        }
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const activeGroup = groups.find((group) => group.open && group.contains(document.activeElement))
        ?? groups.find((group) => group.open);
      if (activeGroup) {
        event.preventDefault();
        activeGroup.open = false;
        activeGroup.querySelector('summary')?.focus();
      } else if (toggle.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    desktop.addEventListener('change', () => setOpen(false));
  }
</script>
<style>
  .site-header { background: rgba(3,9,26,.95); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(196,154,46,.15); }
  .desktop-navigation, .header-actions { display: none; }
  .header-actions { margin-left: auto; }
  .header-cta { border: 1px solid var(--color-gold-500); color: var(--color-gold-500); }
  .header-cta:hover { background: var(--color-gold-500); color: var(--color-navy-950); }
  .theme-toggle { min-height: 36px; padding: .5rem .7rem; border: 1px solid rgba(139,155,180,.35); color: var(--color-slate-blue); background: transparent; cursor: pointer; font-size: .625rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; transition: color .2s, border-color .2s, background .2s; }
  .theme-toggle:hover, .theme-toggle:focus-visible { color: var(--color-gold-500); border-color: var(--color-gold-500); }
  .theme-icon { display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px; }
  .theme-icon svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .theme-icon-sun svg { color:#FFFFFF; stroke:#FFFFFF; }
  .theme-icon-moon svg { fill:currentColor; stroke:none; }
  @media (min-width: 1200px) { .header-actions .theme-toggle { width:38px; min-width:38px; height:36px; padding:.5rem; display:inline-flex; align-items:center; justify-content:center; } .header-actions .theme-toggle .theme-toggle-label { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; } }
  .menu-toggle { color: var(--color-gold-500); width: 44px; height: 44px; align-items: center; justify-content: center; cursor: pointer; }
  .menu-toggle:not([hidden]) { display: flex; }
  .menu-toggle :global(.icon) { width: 24px; height: 24px; }
  .mobile-navigation { border-top: 1px solid rgba(196,154,46,.15); max-height: min(80vh, calc(100svh - 64px)); overflow-y: auto; overscroll-behavior: contain; }
  .mobile-theme-toggle { width: 100%; margin-top: 1.25rem; }
  .mobile-cta { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: .75rem; padding: .65rem 1rem; border: 1px solid var(--color-gold-500); color: var(--color-gold-400); text-align: center; }
  .mobile-cta:hover, .mobile-cta:focus-visible { color: var(--color-navy-950); background: var(--color-gold-400); }
  /* The unenhanced fallback remains usable when JavaScript is disabled. */
  .site-header:not(.enhanced) { position: relative; }
  @media (min-width: 1200px) {
    .desktop-navigation { display: flex; }
    .header-actions { display: flex; }
    .menu-toggle:not([hidden]), .mobile-navigation { display: none; }
    .site-header:not(.enhanced) { position: fixed; }
  }
</style>
