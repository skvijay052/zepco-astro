---
import type { NavigationItem } from '../data/site';

interface Props {
  items: readonly NavigationItem[];
  variant: 'desktop' | 'mobile';
}
const { items, variant } = Astro.props;
---
<ul class:list={['navigation-list', variant]}>
  {items.map((item) => (
    <li class="navigation-item">
      {item.children?.length ? (
        <details class="navigation-group" name={`${variant}-navigation`}>
          <summary class="nav-link" aria-controls={`${variant}-${item.id}-submenu`}>
            <span>{item.label}</span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>
          <div class:list={['submenu-panel', { 'submenu-wide': item.id === 'solutions' }]}>
            <ul id={`${variant}-${item.id}-submenu`} class="submenu">
              {item.children.map(({ label, href }, index) => (
                <li><a href={href}>
                  {variant === 'desktop' && <span class="submenu-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
                  <span>{label}</span>
                </a></li>
              ))}
            </ul>
          </div>
        </details>
      ) : (
        <a class="nav-link" href={item.href}>{item.label}</a>
      )}
    </li>
  ))}
</ul>
<style>
  .navigation-list, .submenu { list-style: none; margin: 0; padding: 0; }
  .nav-link { display: flex; align-items: center; justify-content: space-between; gap: .6rem; min-height: 44px; color: var(--color-slate-blue); font-size: .75rem; font-weight: 500; letter-spacing: .1em; line-height: 1.5; text-transform: uppercase; text-decoration: none; transition: color .2s; }
  .nav-link:hover, .nav-link:focus-visible, .submenu a:hover, .submenu a:focus-visible { color: var(--color-gold-500); }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--color-gold-400); outline-offset: 3px; }
  .chevron { width: .35rem; height: .35rem; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(45deg); flex-shrink: 0; margin: 0 .2rem .2rem; transition: transform .2s; }
  details[open] > summary .chevron { transform: rotate(225deg); margin-bottom: -.1rem; }
  .submenu a { display: flex; align-items: center; min-height: 34px; padding: .4rem 1rem; color: var(--color-slate-blue); font-size: .6875rem; font-weight: 400; line-height: 1.65; letter-spacing: .075em; text-transform: capitalize; text-decoration: none; transition: color .2s; }
  .mobile > .navigation-item { border-bottom: 1px solid rgba(196,154,46,.08); }
  .mobile .submenu { padding: .25rem 0 .8rem; }
  .mobile .submenu a { color: rgba(139,155,180,.7); font-size: .625rem; letter-spacing: .1em; }
  .mobile .submenu a:is(:hover, :focus-visible) { color: var(--color-gold-500); }
  .desktop { display: flex; align-items: center; gap: 1.75rem; }
  .desktop .nav-link { white-space: nowrap; gap: .25rem; }
  .desktop .navigation-group { position: relative; }
  .desktop .submenu-panel { position: absolute; top: 100%; left: 0; z-index: 1; width: 15rem; max-width: calc(100vw - 3rem); padding-top: .5rem; }
  .desktop .submenu-wide { width: 30rem; }
  .desktop .submenu { max-height: calc(100svh - 88px); overflow-y: auto; overscroll-behavior: contain; padding: .5rem 0; background: var(--color-navy-900); border: 1px solid rgba(196,154,46,.18); box-shadow: 0 16px 48px rgba(0,0,0,.6); }
  .desktop .submenu-wide .submenu { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .desktop .submenu a { min-height: 40px; height: 100%; padding: .625rem 1.25rem; gap: .75rem; font-size: .75rem; letter-spacing: .1em; transition: color .15s, background .15s; }
  .desktop .submenu a:is(:hover, :focus-visible) { background: rgba(196,154,46,.06); }
  .submenu-number { width: 1rem; flex-shrink: 0; color: rgba(196,154,46,.4); font-family: monospace; font-size: .625rem; text-align: center; }
  .desktop details[open] > summary { color: var(--color-gold-500); }
</style>
