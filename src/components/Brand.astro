---
interface Props {
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
---
<span class:list={['brand', variant]}>
  <img
    class="brand-logo"
    src="/images/zepco-logo.webp"
    alt="Zepco Technologies"
    width="1342"
    height="520"
    loading={variant === 'header' ? 'eager' : 'lazy'}
    decoding="async"
  />
</span>
<style>
  .brand { display: inline-flex; flex-shrink: 0; align-items: center; padding: 4px 8px; background: transparent; vertical-align: middle; }
  .brand-logo { display: block; width: 124px; height: auto; }
  .footer .brand-logo { width: 184px; }
  :global([data-theme="light"]) .brand-logo { filter: none; }
  :global([data-theme="dark"]) .brand-logo { filter: brightness(0) invert(1); }
</style>
