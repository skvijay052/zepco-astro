---
---
<div id="engineer-drawer" class="engineer-drawer" aria-hidden="true">
  <button type="button" class="drawer-backdrop" data-close-engineer aria-label="Close contact form"></button>
  <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="engineer-drawer-title">
    <div class="drawer-header"><div><p class="drawer-kicker">GET IN TOUCH</p><h2 id="engineer-drawer-title">Talk to an Engineer</h2></div><button type="button" class="drawer-close" data-close-engineer aria-label="Close contact form">×</button></div>
    <p class="drawer-intro">Tell us what you're building and our engineering team will get back to you.</p>
    <form id="engineer-form" class="engineer-form">
      <label><span>Name</span><input name="name" type="text" autocomplete="name" required placeholder="Your name" /></label>
      <label><span>Email</span><input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label>
      <label><span>Phone Number</span><input name="phone" type="tel" autocomplete="tel" placeholder="+91 98765 43210" /></label>
      <label><span>Message</span><textarea name="message" rows="5" required placeholder="Tell us about your requirement..."></textarea></label>
      <button type="submit" class="drawer-submit">Submit <span aria-hidden="true">→</span></button>
      <p id="engineer-form-status" class="form-status" role="status" aria-live="polite"></p>
    </form>
  </aside>
</div>
<script>
  const drawer = document.querySelector<HTMLElement>('#engineer-drawer');
  const form = document.querySelector<HTMLFormElement>('#engineer-form');
  const status = document.querySelector<HTMLElement>('#engineer-form-status');
  if (drawer && form) {
    const openers = document.querySelectorAll<HTMLAnchorElement>('a[data-open-engineer]');
    const closers = drawer.querySelectorAll<HTMLElement>('[data-close-engineer]');
    let lastFocused: HTMLElement | null = null;
    const openDrawer = () => {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      drawer.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('drawer-open');
      window.setTimeout(() => form.querySelector<HTMLInputElement>('input[name="name"]')?.focus(), 50);
    };
    const closeDrawer = () => { drawer.setAttribute('aria-hidden', 'true'); document.documentElement.classList.remove('drawer-open'); lastFocused?.focus(); };
    openers.forEach((opener) => opener.addEventListener('click', (event) => { event.preventDefault(); openDrawer(); }));
    closers.forEach((closer) => closer.addEventListener('click', closeDrawer));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') closeDrawer(); });
    form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.reportValidity()) return; form.reset(); if (status) status.textContent = 'Thank you. Your message has been received.'; });
  }
</script>
<style>
  .engineer-drawer{position:fixed;inset:0;z-index:90;visibility:hidden;pointer-events:none}.engineer-drawer[aria-hidden="false"]{visibility:visible;pointer-events:auto}.drawer-backdrop{position:absolute;inset:0;width:100%;height:100%;border:0;background:rgba(3,9,26,.68);opacity:0;transition:opacity .25s ease}.engineer-drawer[aria-hidden="false"] .drawer-backdrop{opacity:1}.drawer-panel{position:absolute;top:0;right:0;width:min(100%,480px);height:100%;overflow-y:auto;padding:2rem;background:#060F26;color:#FFF;border-left:1px solid rgba(196,154,46,.2);box-shadow:-24px 0 70px rgba(0,0,0,.28);transform:translateX(100%);transition:transform .3s ease}.engineer-drawer[aria-hidden="false"] .drawer-panel{transform:translateX(0)}.drawer-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.25rem}.drawer-kicker{margin:0 0 .5rem;color:#C49A2E;font-size:10px;font-weight:600;letter-spacing:.24em;text-transform:uppercase}.drawer-header h2{margin:0;font-size:clamp(1.8rem,5vw,2.4rem);line-height:1;font-weight:700;text-transform:uppercase}.drawer-close{width:40px;height:40px;border:1px solid rgba(139,155,180,.35);background:transparent;color:#FFF;font-size:26px;cursor:pointer}.drawer-close:hover{border-color:#C49A2E;color:#C49A2E}.drawer-intro{margin:0 0 2rem;color:#8B9BB4;font-size:.9rem;line-height:1.7}.engineer-form{display:grid;gap:1.15rem}.engineer-form label{display:grid;gap:.45rem}.engineer-form label span{color:#8B9BB4;font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase}.engineer-form input,.engineer-form textarea{width:100%;border:1px solid rgba(139,155,180,.28);outline:0;background:#03091A;color:#FFF;padding:.85rem .9rem;font:inherit;font-size:.9rem}.engineer-form textarea{resize:vertical;min-height:130px}.engineer-form input::placeholder,.engineer-form textarea::placeholder{color:rgba(139,155,180,.55)}.engineer-form input:focus,.engineer-form textarea:focus{border-color:#C49A2E;box-shadow:0 0 0 2px rgba(196,154,46,.12)}.drawer-submit{display:inline-flex;align-items:center;justify-content:space-between;width:100%;margin-top:.35rem;padding:1rem 1.1rem;border:0;background:#C49A2E;color:#03091A;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;cursor:pointer}.drawer-submit:hover{background:#D4A93A}.form-status{min-height:1.25rem;margin:0;color:#D4A93A;font-size:.8rem;line-height:1.5}@media(max-width:480px){.drawer-panel{padding:1.5rem}}@media(prefers-reduced-motion:reduce){.drawer-backdrop,.drawer-panel{transition:none}}
</style>