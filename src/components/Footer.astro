---
import Link from './Link.astro';
import { site } from '../data/site';
import { CAPABILITIES } from '../data/homepage';

const companyLinks = [
  { label: 'Our Story', href: site.links.companyStory },
  { label: 'Leadership', href: '#' },
  { label: 'Careers', href: '#' },
];
const technologyLinks = [CAPABILITIES[0], CAPABILITIES[1], CAPABILITIES[2], CAPABILITIES[5]];
const solutionLinks = [
  { label: 'Drone Propulsion', href: '#solution-drone-propulsion' },
  { label: 'Power Supplies', href: '#solution-power-conversion' },
  { label: 'Motor Controllers', href: '#solution-motor-controllers' },
  { label: 'Automated Test Equipment', href: '#solution-automatic-test-equipment' },
];
const resourceLinks = [
  { label: 'Downloads', href: '#' },
  { label: 'Insights', href: '#stories' },
  { label: 'Blogs', href: '#stories' },
  { label: 'Media', href: '#stories' },
];
const connectLinks = [
  { label: 'Contact', href: site.links.contact },
  { label: 'LinkedIn', href: site.links.linkedin ?? '#' },
  { label: 'X', href: site.links.twitter ?? '#' },
  { label: 'Instagram', href: '#' },
  { label: 'Certifications', href: '#certifications' },
  { label: 'Privacy Policy', href: '#privacy-policy' },
  { label: 'Site Map', href: '/sitemap.xml' },
];
const columns = [
  { title: 'Company', links: companyLinks },
  { title: 'Technologies', links: technologyLinks.map((item) => ({ label: item.title.replace(' & ATE', ''), href: item.href ?? '#capabilities' })) },
  { title: 'Solutions', links: solutionLinks },
  { title: 'Resources', links: resourceLinks },
  { title: 'Connect', links: connectLinks },
];
---

<footer class="site-footer py-12 md:py-14" data-reveal>
  <div class="max-w-7xl mx-auto px-6">
    <div class="footer-columns">
      {columns.map((column) => (
        <nav aria-label={`Footer ${column.title}`} class="footer-column">
          <h2 class="footer-column-title">{column.title}</h2>
          <ul class="footer-link-list">
            {column.links.map(({ label, href }) => (
              <li><Link href={href} class="footer-link">{label}</Link></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom pt-8 mt-10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[10px] tracking-widest uppercase font-light">© {new Date().getFullYear()} Zepco Technologies Pvt. Ltd. · Bengaluru, India</p>
      <p class="text-[10px] tracking-widest uppercase font-light">Power Electronics · Electric Propulsion · Engineering</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-navy-950); border-top: 0; }
  .footer-columns { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 0; }
  .footer-column { min-width: 0; min-height: 330px; border-right: 0; }
  .footer-column:last-child { border-right: 0; }
  .footer-column-title {
    margin: 0;
    padding: .9rem 1.1rem;
    background: transparent;
    border-bottom: 0;
    color: #2F80ED;
    font-size: .95rem;
    line-height: 1.35;
    font-weight: 400;
    letter-spacing: .01em;
  }
  .footer-link-list { list-style: none; margin: 0; padding: 3rem 1.1rem 2rem; }
  .footer-link-list li { position: relative; padding-left: 1.25rem; }
  .footer-link-list li::before { content: '•'; position: absolute; left: 0; top: 0; color: var(--color-gold-400); font-size: 1rem; line-height: 1.6; }
  .footer-link { display: inline-block; margin-bottom: .7rem; color: #D6DDE8; font-size: .82rem; line-height: 1.55; font-weight: 300; transition: color .2s ease; }
  .footer-link:hover, .footer-link:focus-visible { color: var(--color-gold-400); }
  .footer-bottom { border-top: 0; color: rgba(139,155,180,.7); }
  @media (max-width: 1023px) { .footer-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); } .footer-column:nth-child(3) { border-right: 0; } .footer-column:nth-child(n + 4) { border-top: 0; } }
  @media (max-width: 639px) { .footer-columns { grid-template-columns: 1fr; } .footer-column, .footer-column:nth-child(3) { min-height: auto; border-right: 0; border-bottom: 0; } .footer-column:last-child { border-bottom: 0; } .footer-column:nth-child(n + 4) { border-top: 0; } .footer-link-list { padding-top: 1.5rem; padding-bottom: 1rem; } }
  :global(html[data-theme='light']) .footer-column-title { background: transparent; color: #2F80ED; }
  :global(html[data-theme='light']) .footer-column,
  :global(html[data-theme='light']) .footer-columns { border-color: transparent; }
  :global(html[data-theme='light']) .footer-link { color: #4F5A6A; }
  :global(html[data-theme='light']) .footer-link:hover,
  :global(html[data-theme='light']) .footer-link:focus-visible { color: #2F80ED; }
</style>
