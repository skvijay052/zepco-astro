---
import Link from './Link.astro';
import { STORIES } from '../data/homepage';
---
<section data-reveal id="media" class="section-media py-28" style={{ background: "var(--color-navy-900)" }}>
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-px w-8" style={{ background: "var(--color-gold-500)" }} />
      <span class="text-[10px] tracking-[0.3em] uppercase" style={{ color: "var(--color-gold-500)" }}>Media</span>
    </div>
    <div class="mb-16 w-full">
      <h2 class="font-display font-bold text-5xl leading-tight w-full" style={{ letterSpacing: "0.02em", textTransform: "none" }}>
        In the Media
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {STORIES.map((item) => (
        <Link href={item.href} class="group block">
          <div class="overflow-hidden relative mb-4" style={{ height: "260px", background: "var(--color-navy-950)" }}>
            <img src={`/images/${item.img}-400.jpg`} width="600" height="400" loading="lazy" decoding="async" alt={item.title} class="w-full h-full object-cover transition-transform duration-700" style={{ transform: "scale(1)", filter: "brightness(0.45) saturate(0.25)" }} />
            <div class="absolute top-4 left-4"><span class="text-[10px] tracking-widest uppercase font-semibold px-3 py-1.5" style={{ background: "var(--color-gold-500)", color: "#ffffff" }}>Media</span></div>
          </div>
          <div class="pt-2">
            <div class="text-[10px] tracking-widest uppercase mb-3 font-light" style={{ color: "rgba(1,138,193,0.7)" }}>{item.date}</div>
            <h3 class="font-display font-bold text-xl leading-tight transition-colors duration-200" style={{ letterSpacing: "0.03em", color: "#ffffff", textTransform: "none" }}>{item.title}</h3>
            <div class="mt-4 h-px transition-all duration-300" style={{ background: "var(--color-gold-500)", width: "24px" }} />
          </div>
        </Link>
      ))}
    </div>
  </div>
</section>
