---
import { PILLARS } from '../data/homepage';
---
<section data-reveal id="trust" class="section-trust py-28" style={{ background: "var(--color-navy-900)" }}>
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-8" style={{ background: "var(--color-gold-500)" }} />
          <span class="text-[10px] tracking-[0.3em] uppercase" style={{ color: "var(--color-gold-500)" }}>Trust</span>
        </div>
        <div class="mb-16">
          <h2 class="font-display font-bold uppercase text-5xl leading-tight" style={{ letterSpacing: "0.02em" }}>
            Why Customers<br />Trust <span style={{ color: "var(--color-gold-500)" }}>Zepco</span>
          </h2>
          <p class="text-sm leading-relaxed mt-8 font-light max-w-none w-full" style={{ color: "var(--color-slate-blue)" }}>
            Trust is earned through engineering excellence, technical integrity and consistent execution. Every project reflects our commitment to solving complex power electronics and propulsion challenges through collaborative development, rigorous validation and long-term partnership.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-px" style={{ background: "rgba(196,154,46,0.1)" }}>
          {PILLARS.map((p, i) => (
            <div class="p-6 group transition-colors duration-300 hover:bg-[#0C1B38]" style={{ background: "var(--color-navy-900)" }}>
              <div class="font-display font-bold text-4xl mb-4 leading-none" style={{ color: "rgba(196,154,46,0.15)" }}>
                {String(i + 1).padStart(2, "0")}
              </div>
              <h3 class="font-display font-bold uppercase text-base mb-3 leading-tight" style={{ letterSpacing: "0.04em", color: "#ffffff" }}>
                {p.title}
              </h3>
              <p class="text-xs leading-relaxed font-light" style={{ color: "var(--color-slate-blue)" }}>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
