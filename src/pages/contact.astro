---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EngineerDrawer from '../components/EngineerDrawer.astro';
---

<BaseLayout
  title="Contact Zepco Technologies | Power Electronics & Electric Propulsion"
  description="Contact Zepco Technologies in Bengaluru for advanced power electronics, electric propulsion, engineering and custom technology solutions."
>
  <Navbar />

  <main id="main-content" tabindex="-1" class="contact-page">
    <section class="contact-hero">
      <div class="hero-grid"></div>
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> Contact Zepco</div>
          <h1>Let's build<br /><em>what's next.</em></h1>
          <p>Tell us about your engineering challenge, product requirement or technology roadmap. Our team in Bengaluru is ready to talk.</p>
        </div>
      </div>
    </section>

    <section class="contact-main">
      <div class="max-w-7xl mx-auto px-6">
        <div class="contact-grid">
          <div class="contact-form-card">
            <div class="section-kicker"><span></span> Start a Conversation</div>
            <h2>Talk to<br /><em>an Engineer.</em></h2>
            <p class="intro">Share a few details and our engineering team will get back to you.</p>

            <form id="contact-form" class="contact-form">
              <label>
                <span>Name</span>
                <input name="name" type="text" autocomplete="name" required placeholder="Your name" />
              </label>
              <label>
                <span>Email</span>
                <input name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
              </label>
              <label>
                <span>Phone Number</span>
                <input name="phone" type="tel" autocomplete="tel" placeholder="+91 98765 43210" />
              </label>
              <label>
                <span>Message</span>
                <textarea name="message" rows="6" required placeholder="Tell us about your requirement..."></textarea>
              </label>
              <button type="submit">Submit <span aria-hidden="true">→</span></button>
              <p id="contact-form-status" class="form-status" role="status" aria-live="polite"></p>
            </form>
          </div>

          <aside class="contact-details">
            <div class="section-kicker"><span></span> Find Us</div>
            <h2>Engineering<br /><em>from Bengaluru.</em></h2>
            <p class="detail-copy">Our engineering and product development work is based in Bengaluru, Karnataka.</p>

            <div class="detail-list">
              <div>
                <span>Address</span>
                <strong>Ground Floor, Survey No: 19/3,<br />Bikasipura Main Road,<br />JC Industrial Estate,<br />Bengaluru – 560 062</strong>
              </div>
              <div>
                <span>Email</span>
                <a href="mailto:info@zepcotek.com">info@zepcotek.com</a>
              </div>
              <div>
                <span>Phone</span>
                <a href="tel:+918068954293">+91 80 6895 4293</a>
              </div>
            </div>

            <a class="directions-link" href="https://www.google.com/maps/dir/?api=1&destination=Zepco+Technologies%2C+Bikasipura+Main+Road%2C+Bengaluru%2C+Karnataka+560062" target="_blank" rel="noopener noreferrer">
              Get Directions <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </div>
    </section>

    <section class="map-section">
      <div class="max-w-7xl mx-auto px-6">
        <div class="map-heading">
          <div>
            <div class="section-kicker"><span></span> Our Location</div>
            <h2>Come meet<br /><em>the team.</em></h2>
          </div>
          <p>Visit our Bengaluru facility to discuss your next power electronics, propulsion or electrification challenge.</p>
        </div>
        <div class="map-card">
          <iframe
            title="Zepco Technologies location in Bengaluru"
            src="https://www.google.com/maps?q=Zepco+Technologies%2C+Bikasipura+Main+Road%2C+Bengaluru%2C+Karnataka+560062&output=embed"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
          <div class="map-label">
            <span class="map-pin">●</span>
            <div><strong>Zepco Technologies</strong><small>Bikasipura Main Road · Bengaluru 560 062</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-bottom">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <div class="eyebrow center"><span></span> Have a Challenge? <span></span></div>
        <h2>Good engineering<br /><em>starts with a conversation.</em></h2>
        <p>Whether you need a custom power system, electric propulsion solution or engineering partner, tell us what you're trying to achieve.</p>
      </div>
    </section>
  </main>

  <Footer />
  <EngineerDrawer />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-form-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    form.reset();
    if (status) status.textContent = 'Thank you. Your message has been received.';
  });
</script>

<style>
  .contact-page { background:#fff; color:#111; }
  .contact-hero { min-height:68vh; display:flex; align-items:center; position:relative; overflow:hidden; padding:9rem 0 6rem; background:#03091a; color:#fff; }
  .hero-grid { position:absolute; inset:0; opacity:.32; background-image:linear-gradient(rgba(196,154,46,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(196,154,46,.09) 1px,transparent 1px); background-size:72px 72px; mask-image:linear-gradient(to bottom,#000,transparent 88%); }
  .hero-copy { max-width:850px; }
  .eyebrow,.section-kicker { display:flex; align-items:center; gap:.75rem; color:#c49a2e; font-size:10px; letter-spacing:.28em; text-transform:uppercase; font-weight:600; }
  .eyebrow span,.section-kicker span { display:block; width:32px; height:1px; background:#c49a2e; }
  .eyebrow.center { justify-content:center; }
  .contact-hero h1 { margin:1.6rem 0 1.75rem; font-size:clamp(3.8rem,8vw,7.4rem); line-height:.88; text-transform:uppercase; letter-spacing:-.025em; }
  .contact-hero h1 em,.contact-page h2 em { color:#c49a2e; font-style:normal; }
  .contact-hero p { max-width:650px; color:#aeb8c8; font-size:1.08rem; line-height:1.8; font-weight:300; }
  .contact-main { padding:7rem 0; }
  .contact-grid { display:grid; grid-template-columns:1.12fr .88fr; gap:5rem; align-items:start; }
  .contact-form-card { padding:3rem; background:#f7f7f7; border:1px solid #e3e3e3; }
  .contact-form-card h2,.contact-details h2,.map-heading h2,.contact-bottom h2 { margin:1.25rem 0 1rem; font-size:clamp(2.6rem,5vw,4.6rem); line-height:.95; text-transform:uppercase; letter-spacing:-.02em; }
  .intro,.detail-copy { color:#666; line-height:1.75; font-size:.95rem; font-weight:300; }
  .contact-form { display:grid; gap:1.2rem; margin-top:2.2rem; }
  .contact-form label { display:grid; gap:.45rem; }
  .contact-form label span,.detail-list span { color:#8a8a8a; font-size:10px; font-weight:600; letter-spacing:.17em; text-transform:uppercase; }
  .contact-form input,.contact-form textarea { width:100%; border:1px solid #d8d8d8; outline:0; background:#fff; color:#111; padding:.9rem 1rem; font:inherit; font-size:.9rem; transition:border-color .2s,box-shadow .2s; }
  .contact-form textarea { resize:vertical; min-height:145px; }
  .contact-form input::placeholder,.contact-form textarea::placeholder { color:#aaa; }
  .contact-form input:focus,.contact-form textarea:focus { border-color:#c49a2e; box-shadow:0 0 0 2px rgba(196,154,46,.1); }
  .contact-form button { display:flex; align-items:center; justify-content:space-between; margin-top:.3rem; padding:1rem 1.2rem; border:0; background:#c49a2e; color:#03091a; font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; cursor:pointer; }
  .contact-form button:hover { background:#d4a93a; }
  .form-status { min-height:1.25rem; margin:0; color:#9b7620; font-size:.8rem; }
  .contact-details { padding:2rem 0 0; }
  .detail-copy { max-width:470px; margin-bottom:2.5rem; }
  .detail-list { border-top:1px solid #ddd; }
  .detail-list > div { padding:1.25rem 0; border-bottom:1px solid #ddd; display:grid; gap:.45rem; }
  .detail-list strong { font-size:.9rem; line-height:1.65; font-weight:400; }
  .detail-list a { color:#111; text-decoration:none; font-size:.95rem; }
  .detail-list a:hover { color:#9b7620; }
  .directions-link { display:inline-flex; align-items:center; gap:.75rem; margin-top:1.8rem; color:#9b7620; font-size:10px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; text-decoration:none; }
  .directions-link:hover { color:#c49a2e; }
  .map-section { padding:0 0 7rem; }
  .map-heading { display:flex; align-items:end; justify-content:space-between; gap:3rem; margin-bottom:2.5rem; }
  .map-heading > p { max-width:420px; color:#666; font-size:.95rem; line-height:1.75; font-weight:300; margin:0 0 .5rem; }
  .map-card { position:relative; min-height:520px; overflow:hidden; border:1px solid #ddd; background:#e8e8e8; }
  .map-card iframe { display:block; width:100%; height:520px; border:0; filter:saturate(.7) contrast(.95); }
  .map-label { position:absolute; left:1.5rem; bottom:1.5rem; display:flex; align-items:center; gap:.8rem; padding:.9rem 1.1rem; background:rgba(3,9,26,.94); color:#fff; box-shadow:0 12px 35px rgba(0,0,0,.2); }
  .map-pin { color:#c49a2e; font-size:14px; }
  .map-label strong,.map-label small { display:block; }
  .map-label strong { font-size:.75rem; text-transform:uppercase; letter-spacing:.08em; }
  .map-label small { margin-top:.25rem; color:#9ba9bc; font-size:.68rem; }
  .contact-bottom { padding:8rem 0; background:#03091a; color:#fff; }
  .contact-bottom h2 { margin-top:1.5rem; }
  .contact-bottom p { max-width:650px; margin:0 auto; color:#aeb8c8; line-height:1.8; font-weight:300; }
  html[data-theme='dark'] .contact-page { background:#03091a; color:#fff; }
  html[data-theme='dark'] .contact-main { background:#03091a; }
  html[data-theme='dark'] .contact-form-card { background:#071127; border-color:rgba(196,154,46,.15); }
  html[data-theme='dark'] .intro,html[data-theme='dark'] .detail-copy,html[data-theme='dark'] .map-heading > p { color:#aeb8c8; }
  html[data-theme='dark'] .contact-form label span,html[data-theme='dark'] .detail-list span { color:#8b9bb4; }
  html[data-theme='dark'] .contact-form input,html[data-theme='dark'] .contact-form textarea { background:#03091a; color:#fff; border-color:rgba(139,155,180,.28); }
  html[data-theme='dark'] .contact-form input::placeholder,html[data-theme='dark'] .contact-form textarea::placeholder { color:rgba(139,155,180,.55); }
  html[data-theme='dark'] .detail-list { border-color:rgba(196,154,46,.18); }
  html[data-theme='dark'] .detail-list > div { border-color:rgba(196,154,46,.18); }
  html[data-theme='dark'] .detail-list a { color:#fff; }
  html[data-theme='dark'] .map-card { border-color:rgba(196,154,46,.18); }
  html[data-theme='dark'] .map-card iframe { filter:brightness(.72) saturate(.7) contrast(.95); }
  @media(max-width:900px) {
    .contact-grid { grid-template-columns:1fr; gap:4rem; }
    .contact-form-card { padding:2rem; }
    .map-heading { align-items:start; flex-direction:column; gap:1rem; }
  }
  @media(max-width:600px) {
    .contact-hero { min-height:65vh; padding:8rem 0 4.5rem; }
    .contact-hero h1 { font-size:3.5rem; }
    .contact-main { padding:5rem 0; }
    .contact-form-card { padding:1.5rem; }
    .map-section { padding-bottom:5rem; }
    .map-card,.map-card iframe { min-height:380px; height:380px; }
    .map-label { left:.75rem; right:.75rem; bottom:.75rem; }
    .contact-bottom { padding:6rem 0; }
  }
</style>
