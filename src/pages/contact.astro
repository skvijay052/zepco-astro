---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EngineerDrawer from '../components/EngineerDrawer.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<BaseLayout
  title="Contact Zepco Technologies | Power Electronics & Electric Propulsion"
  description="Contact Zepco Technologies in Bengaluru for advanced power electronics, electric propulsion, engineering and custom technology solutions."
>
  <Navbar />

  <main id="main-content" tabindex="-1" class="contact-page">
    <section class="story-hero contact-hero" data-reveal>
      <img src="/images/contact-banner.png" alt="Engineers working together on advanced technology" />
      <div class="hero-overlay"></div>
      <div class="hero-bottom-shade"></div>
      <div class="hero-grid"></div>
      <div class="story-container hero-inner">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> Contact Zepco</div>
          <h1>Let's build<br /><em>what's next.</em></h1>
          <p>Tell us about your engineering challenge, product requirement or technology roadmap. Our team in Bengaluru is ready to talk.</p>
        </div>
      </div>
    </section>

    <section class="contact-main" data-reveal>
      <div class="max-w-7xl mx-auto px-6">
        <div class="contact-grid">
          <div class="contact-form-card">
            <div class="section-kicker"><span></span> Start a Conversation</div>
            <h2>Talk to<br /><em>an Engineer.</em></h2>
            <p class="intro">Share a few details and our engineering team will get back to you.</p>
            <form id="contact-form" class="contact-form">
              <label><span>Name</span><input name="name" type="text" autocomplete="name" required placeholder="Your name" /></label>
              <label><span>Email</span><input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label>
              <label><span>Phone Number</span><input name="phone" type="tel" autocomplete="tel" placeholder="+91 98765 43210" /></label>
              <label><span>Message</span><textarea name="message" rows="6" required placeholder="Tell us about your requirement..."></textarea></label>
              <button type="submit">Submit <span aria-hidden="true">→</span></button>
              <p id="contact-form-status" class="form-status" role="status" aria-live="polite"></p>
            </form>
          </div>

          <aside class="contact-details">
            <div class="section-kicker"><span></span> Find Us</div>
            <h2>Engineering<br /><em>from Bengaluru.</em></h2>
            <p class="detail-copy">Our engineering and product development work is based in Bengaluru, Karnataka.</p>
            <div class="detail-list">
              <div><span>Address</span><strong>Ground Floor, Survey No: 19/3,<br />Bikasipura Main Road,<br />JC Industrial Estate,<br />Bengaluru – 560 062</strong></div>
              <div><span>Email</span><a href="mailto:info@zepcotek.com">info@zepcotek.com</a></div>
              <div><span>Phone</span><a href="tel:+918068954293">+91 80 6895 4293</a></div>
            </div>
            <a class="directions-link" href="https://www.google.com/maps/dir/?api=1&destination=Zepco+Technologies%2C+Bikasipura+Main+Road%2C+Bengaluru%2C+Karnataka+560062" target="_blank" rel="noopener noreferrer">Get Directions <span aria-hidden="true">↗</span></a>
          </aside>
        </div>
      </div>
    </section>

    <section class="map-section" data-reveal>
      <div class="max-w-7xl mx-auto px-6">
        <div class="map-heading">
          <div><div class="section-kicker"><span></span> Our Location</div><h2>Come meet<br /><em>the team.</em></h2></div>
          <p>Visit our Bengaluru facility to discuss your next power electronics, propulsion or electrification challenge.</p>
        </div>
        <div class="map-card">
          <iframe title="Zepco Technologies location in Bengaluru" src="https://www.google.com/maps?q=Zepco+Technologies%2C+Bikasipura+Main+Road%2C+Bengaluru%2C+Karnataka+560062&output=embed" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <div class="map-label"><span class="map-pin">●</span><div><strong>Zepco Technologies</strong><small>Bikasipura Main Road · Bengaluru 560 062</small></div></div>
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>

  <Footer />
  <EngineerDrawer />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-form-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    form.reset();
    if (status) status.textContent = 'Thank you. Your message has been received.';
  });
</script>

<style>
  .contact-page { background:#fff; color:#111; }
  .story-container{width:min(1180px,calc(100% - 48px));margin:0 auto}
  .story-container{width:min(1180px,calc(100% - 48px));margin:0 auto}
  .contact-hero{min-height:100vh;position:relative;display:flex;align-items:center;background:#03091a;color:#fff;overflow:hidden}
  .contact-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:.55;animation:story-bg-drift 22s ease-in-out infinite alternate;transform-origin:center center}
  @keyframes story-bg-drift{from{transform:scale(1.02) translate3d(-1.2%, -0.6%, 0)}to{transform:scale(1.08) translate3d(1.2%, 0.6%, 0)}}
  .contact-hero .hero-overlay{position:absolute;inset:0;background:linear-gradient(105deg,rgba(3,9,26,.93) 0%,rgba(3,9,26,.76) 45%,rgba(3,9,26,.35) 100%)}
  .contact-hero .hero-bottom-shade{position:absolute;bottom:0;left:0;right:0;height:12rem;background:linear-gradient(to bottom,transparent,#03091a)}
  .contact-hero .hero-grid{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(196,154,46,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(196,154,46,.03) 1px,transparent 1px);background-size:80px 80px}
  .contact-hero .hero-inner{position:relative;z-index:2;padding:16rem 0 11rem}.contact-hero .hero-copy{max-width:850px}.contact-hero .eyebrow,.section-kicker{display:flex;align-items:center;gap:.75rem;color:#c49a2e;font-size:10px;letter-spacing:.28em;text-transform:uppercase;font-weight:600}.contact-hero .eyebrow span,.section-kicker i{display:block;width:32px;height:1px;background:#c49a2e}.contact-hero .hero-copy h1{margin:1.6rem 0 1.75rem;font-size:clamp(3rem,7.5vw,6.2rem);line-height:.95;text-transform:uppercase;letter-spacing:.02em;font-weight:700}.contact-hero .hero-copy h1 em,h2 em{color:#c49a2e;font-style:normal}.contact-hero .hero-copy p{max-width:650px;color:#aeb8c8;font-size:1rem;line-height:1.75;font-weight:300}.contact-hero .hero-scroll{position:absolute;right:32px;bottom:38px;z-index:2;color:rgba(255,255,255,.55);font-size:9px;letter-spacing:.25em;text-transform:uppercase;display:flex;align-items:center;gap:12px;writing-mode:vertical-rl}.contact-hero .hero-scroll span{width:1px;height:48px;background:#c49a2e}
  .contact-main { padding:7rem 0; }
  .contact-grid { display:grid; grid-template-columns:1.12fr .88fr; gap:5rem; align-items:start; }
  .contact-form-card { padding:3rem; background:#f7f7f7; border:1px solid #e3e3e3; }
  .contact-form-card h2,.contact-details h2,.map-heading h2 { margin:1.25rem 0 1rem; font-size:3rem; line-height:1.25; text-transform:uppercase; letter-spacing:.02em; font-weight:700; }
  .intro,.detail-copy { color:#666; line-height:1.75; font-size:.95rem; font-weight:300; }
  .contact-form { display:grid; gap:1.2rem; margin-top:2.2rem; }
  .contact-form label { display:grid; gap:.45rem; }
  .contact-form label span,.detail-list span { color:#8a8a8a; font-size:10px; font-weight:600; letter-spacing:.17em; text-transform:uppercase; }
  .contact-form input,.contact-form textarea { width:100%; border:1px solid #d8d8d8; outline:0; background:#fff; color:#111; padding:.9rem 1rem; font:inherit; font-size:.9rem; transition:border-color .2s,box-shadow .2s; }
  .contact-form textarea { resize:vertical; min-height:145px; }
  .contact-form input::placeholder,.contact-form textarea::placeholder { color:#aaa; }
  .contact-form input:focus,.contact-form textarea:focus { border-color:#c49a2e; box-shadow:0 0 0 2px rgba(196,154,46,.1); }
  .contact-form button { display:flex; align-items:center; justify-content:space-between; margin-top:.3rem; padding:1rem 1.2rem; border:0; background:#c49a2e; color:#fff; font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; cursor:pointer; }
  .contact-form button:hover { background:#d4a93a; }
  .form-status { min-height:1.25rem; margin:0; color:#9b7620; font-size:.8rem; }
  .contact-details { padding:2rem 0 0; }
  .detail-copy { max-width:470px; margin-bottom:2.5rem; }
  .detail-list { border-top:1px solid #ddd; }
  .detail-list > div { padding:1.25rem 0; border-bottom:1px solid #ddd; display:grid; gap:.45rem; }
  .detail-list strong { font-size:.9rem; line-height:1.65; font-weight:400; }
  .detail-list a { color:#111; text-decoration:none; font-size:.95rem; }
  .detail-list a:hover { color:#9b7620; }
  .directions-link { display:inline-flex; align-items:center; gap:.75rem; margin-top:1.8rem; color:#9b7620; font-size:10px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; text-decoration:none; }
  .directions-link:hover { color:#c49a2e; }
  .map-section { padding:0 0 7rem; }
  .map-heading { display:flex; align-items:end; justify-content:space-between; gap:3rem; margin-bottom:2.5rem; }
  .map-heading > p { max-width:420px; color:#666; font-size:.95rem; line-height:1.75; font-weight:300; margin:0 0 .5rem; }
  .map-card { position:relative; min-height:520px; overflow:hidden; border:1px solid #ddd; background:#e8e8e8; }
  .map-card iframe { display:block; width:100%; height:520px; border:0; filter:saturate(.7) contrast(.95); }
  .map-label { position:absolute; left:1.5rem; bottom:1.5rem; display:flex; align-items:center; gap:.8rem; padding:.9rem 1.1rem; background:rgba(3,9,26,.94); color:#fff; box-shadow:0 12px 35px rgba(0,0,0,.2); }
  .map-pin { color:#c49a2e; font-size:14px; }
  .map-label strong,.map-label small { display:block; }
  .map-label strong { font-size:.75rem; text-transform:uppercase; letter-spacing:.08em; }
  .map-label small { margin-top:.25rem; color:#9ba9bc; font-size:.68rem; }
  html[data-theme='dark'] .contact-page { background:#03091a; color:#fff; }
  html[data-theme='dark'] .contact-main { background:#03091a; }
  html[data-theme='dark'] .contact-form-card { background:#071127; border-color:rgba(196,154,46,.15); }
  html[data-theme='dark'] .intro,html[data-theme='dark'] .detail-copy,html[data-theme='dark'] .map-heading > p { color:#aeb8c8; }
  html[data-theme='dark'] .contact-form label span,html[data-theme='dark'] .detail-list span { color:#8b9bb4; }
  html[data-theme='dark'] .contact-form input,html[data-theme='dark'] .contact-form textarea { background:#03091a; color:#fff; border-color:rgba(139,155,180,.28); }
  html[data-theme='dark'] .contact-form input::placeholder,html[data-theme='dark'] .contact-form textarea::placeholder { color:rgba(139,155,180,.55); }
  html[data-theme='dark'] .detail-list { border-color:rgba(196,154,46,.18); }
  html[data-theme='dark'] .detail-list > div { border-color:rgba(196,154,46,.18); }
  html[data-theme='dark'] .detail-list a { color:#fff; }
  html[data-theme='dark'] .map-card { border-color:rgba(196,154,46,.18); }
  html[data-theme='dark'] .map-card iframe { filter:brightness(.72) saturate(.7) contrast(.95); }
  @media(max-width:1599px) and (min-width:901px) { .contact-hero h1 { font-size:clamp(3rem,7.5vw,6.2rem); } }
  @media(prefers-reduced-motion:reduce){.contact-hero::after{animation:none}}
  @media(max-width:900px) { .contact-grid { grid-template-columns:1fr; gap:4rem; } .contact-form-card { padding:2rem; } .map-heading { align-items:start; flex-direction:column; gap:1rem; } }
  @media(max-width:600px) { .contact-hero { min-height:100vh; } .contact-hero .hero-inner { padding:7rem 0 6rem; } .contact-hero h1 { font-size:clamp(2.8rem,12vw,5rem); line-height:.95; } .contact-main { padding:5rem 0; } .contact-form-card { padding:1.5rem; } .map-section { padding-bottom:5rem; } .map-card,.map-card iframe { min-height:380px; height:380px; } .map-label { left:.75rem; right:.75rem; bottom:.75rem; } }
</style>
