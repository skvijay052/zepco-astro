---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Aerospace & Defence | Zepco Technologies" description="Advanced aerospace and defence power electronics and electric propulsion technologies engineered for mission-critical platforms.">
  <Navbar />

  <main id="main-content" class="ad-page" tabindex="-1">
    <section class="ad-hero">
      <div class="ad-hero-bg"><img src="/images/aerospace.png" alt="Aerospace and defence engineering platform" /><div class="ad-hero-overlay"></div><div class="ad-hero-bottom"></div></div>
      <div class="ad-hero-angle"></div>
      <div class="ad-container ad-hero-content">
        <div class="ad-eyebrow"><i></i> Industries / Aerospace &amp; Defence</div>
        <h1>Engineering Confidence<br /><span>for Mission-Critical</span><br />Systems</h1>
        <p>Advanced aerospace and defence platforms demand more than performance — they demand engineering that stays dependable under extreme conditions, integrates seamlessly into complex systems, and performs throughout long operational lifecycles. Zepco develops advanced power electronics and electric propulsion technologies for customers building the next generation of aerospace and defence platforms.</p>
        <div class="ad-actions"><a class="ad-btn primary" href="#capabilities">Explore Capabilities <b>→</b></a><a class="ad-btn outline" href="#contact">Talk to an Engineer <b>→</b></a></div>
      </div>
      <div class="ad-container ad-hero-strip"><div><small>01</small><strong>Power Electronics</strong></div><div><small>02</small><strong>Electric Propulsion</strong></div><div><small>03</small><strong>Mission Electronics</strong></div><div><small>04</small><strong>System Integration</strong></div></div>
    </section>

    <section class="ad-challenge ad-light"><div class="ad-container ad-split"><div class="ad-heading"><div class="ad-eyebrow blue"><i></i> Understanding the Challenge</div><h2>The mission is demanding.<br /><span>The engineering must be dependable.</span></h2></div><div class="ad-copy"><p class="lead">Modern aerospace and defence systems must balance power density, thermal management, efficiency, weight and reliability while meeting demanding programme schedules and stringent operational requirements.</p><p>These challenges require more than products — they require experienced engineering partners who understand how individual power and propulsion technologies must perform as part of a larger system.</p><div class="ad-metrics"><div><i></i>Power density</div><div><i></i>Thermal management</div><div><i></i>Efficiency</div><div><i></i>Weight</div><div><i></i>Reliability</div></div></div></div></section>

    <section class="ad-capabilities ad-dark" id="capabilities"><div class="ad-container"><div class="ad-intro-grid"><div><div class="ad-eyebrow cyan"><i></i> How Zepco Helps</div><h2>Engineering capability<br /><span>behind the platform.</span></h2></div><p>Our multidisciplinary team works alongside customers from concept through deployment, combining advanced power electronics expertise with practical engineering experience.</p></div><div class="ad-cap-grid">
      <article class="ad-cap large"><div class="icon">ϟ</div><small>01</small><h3>Advanced Power Conversion</h3><p>Efficient, high-density conversion architectures for demanding airborne, ground and naval platforms.</p></article>
      <article class="ad-cap"><div class="icon">◉</div><small>02</small><h3>Electric Propulsion Systems</h3><p>Power and propulsion engineering for next-generation electric and hybrid platforms.</p></article>
      <article class="ad-cap"><div class="icon">◎</div><small>03</small><h3>Motor Controllers</h3><p>Precision control electronics engineered for responsive, efficient and reliable actuation.</p></article>
      <article class="ad-cap"><div class="icon">▣</div><small>04</small><h3>Battery Management Systems</h3><p>Intelligent monitoring, protection and control for mission-critical energy storage.</p></article>
      <article class="ad-cap"><div class="icon">⌘</div><small>05</small><h3>Programmable Power Supplies</h3><p>Flexible, controlled power for development, validation, test and evaluation environments.</p></article>
      <article class="ad-cap"><div class="icon">◫</div><small>06</small><h3>Embedded Electronics</h3><p>Purpose-built electronics that integrate cleanly into complex platform architectures.</p></article>
      <article class="ad-cap"><div class="icon">✦</div><small>07</small><h3>Custom Engineering</h3><p>Collaborative engineering for requirements that call for a purpose-designed solution.</p></article>
    </div><div class="ad-section-note"><i></i>Every programme is approached with a focus on technical excellence, collaborative development and long-term support.</div></div></section>

    <section class="ad-designed"><div class="ad-container"><div class="ad-split ad-designed-head"><div><div class="ad-eyebrow blue"><i></i> Designed for Demanding Applications</div><h2>Built around the realities<br /><span>of operation.</span></h2></div><p>Our technologies are engineered for high reliability, efficient thermal management, high power density, long lifecycle support, environmental robustness, design flexibility and system integration — so customers can develop platforms that perform reliably in demanding operational environments.</p></div><div class="ad-attributes"><div class="featured"><b>01</b><strong>High reliability</strong></div><div><b>02</b><strong>Efficient thermal management</strong></div><div><b>03</b><strong>High power density</strong></div><div class="featured"><b>04</b><strong>Long lifecycle support</strong></div><div><b>05</b><strong>Environmental robustness</strong></div><div><b>06</b><strong>Design flexibility</strong></div><div><b>07</b><strong>System integration</strong></div></div></div></section>

    <section class="ad-applications"><div class="ad-container"><div class="ad-app-head"><div><div class="ad-eyebrow blue"><i></i> Applications</div><h2>Powering the platforms<br /><span>that matter.</span></h2></div><p>From unmanned systems to naval power architectures, Zepco technologies are designed to integrate into demanding mission environments.</p></div><div class="ad-app-grid"><article><small>01</small><span>↗</span><h3>Unmanned Aerial Systems</h3></article><article><small>02</small><span>↗</span><h3>Ground Defence Platforms</h3></article><article><small>03</small><span>↗</span><h3>Naval Power Systems</h3></article><article><small>04</small><span>↗</span><h3>Test &amp; Evaluation Equipment</h3></article><article><small>05</small><span>↗</span><h3>Mission Electronics</h3></article><article><small>06</small><span>↗</span><h3>Portable Defence Systems</h3></article></div></div></section>

    <section class="ad-why"><div class="ad-grid-overlay"></div><div class="ad-container ad-why-grid"><div><div class="ad-eyebrow cyan"><i></i> Why Aerospace Organisations Work With Zepco</div><h2>A partner for the<br /><span>long mission.</span></h2><p>Customers choose Zepco for deep expertise in advanced power electronics, collaborative engineering, end-to-end product development, indigenous design capability, manufacturing support and long-term engineering partnerships.</p></div><div class="ad-why-list"><div><small>01</small>Deep expertise in advanced power electronics</div><div><small>02</small>Collaborative engineering</div><div><small>03</small>End-to-end product development</div><div><small>04</small>Indigenous design capability</div><div><small>05</small>Manufacturing support</div><div><small>06</small>Long-term engineering partnerships</div></div></div></section>

    <section class="ad-cta" id="contact"><div class="ad-container"><small>Engineering the next generation</small><h2>Have a demanding<br />platform to build?</h2><p>Bring your requirements, constraints and mission objectives. Our engineers can work with you from concept through deployment.</p><a class="ad-btn dark" href="mailto:engineering@zepco.com">Talk to an Engineer <b>→</b></a></div></section>
  </main>

  <Footer />

  <style>
    .ad-page{font-family:'Inter',sans-serif;color:#07090d;background:#fff;line-height:1.5}
    .ad-container{width:min(1180px,calc(100% - 48px));margin:auto}
    .ad-page section{position:relative}.ad-hero{min-height:820px;overflow:hidden;background:#020711;color:#fff;position:relative}.ad-hero-bg,.ad-hero-bg img,.ad-hero-overlay,.ad-hero-bottom{position:absolute;inset:0}.ad-hero-bg img{width:100%;height:100%;object-fit:cover;filter:saturate(.55) brightness(.58) contrast(1.08)}.ad-hero-overlay{background:linear-gradient(90deg,#020711 0%,rgba(2,7,17,.97) 24%,rgba(2,7,17,.72) 53%,rgba(2,7,17,.15) 100%)}.ad-hero-bottom{background:linear-gradient(0deg,#020711 0%,transparent 34%,rgba(2,7,17,.12) 100%)}.ad-hero-angle{position:absolute;right:6%;top:0;width:47%;height:100%;clip-path:polygon(20% 0,100% 0,81% 100%,0 100%);background:linear-gradient(135deg,rgba(0,138,193,.13),transparent 65%);border-left:1px solid rgba(71,164,255,.22)}.ad-hero-content{position:relative;padding-top:180px;padding-bottom:190px}.ad-eyebrow{display:flex;align-items:center;gap:12px;color:#2b9fe0;font-size:10px;font-weight:700;letter-spacing:.28em;text-transform:uppercase}.ad-eyebrow i{display:block;width:48px;height:1px;background:#008ac1}.ad-eyebrow.blue{color:#008ac1}.ad-eyebrow.cyan{color:#2b9fe0}.ad-hero h1{font-size:clamp(48px,6.4vw,104px);line-height:.96;letter-spacing:-.03em;margin:28px 0 30px;font-weight:800;max-width:950px}.ad-hero h1 span,.ad-heading h2 span,.ad-intro-grid h2 span,.ad-designed h2 span,.ad-app-head h2 span,.ad-why h2 span{color:#2b9fe0}.ad-hero p{max-width:760px;color:rgba(255,255,255,.7);font-size:16px;line-height:1.75;font-weight:300;margin:0 0 34px}.ad-actions{display:flex;flex-wrap:wrap;gap:13px}.ad-btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;text-decoration:none;text-transform:uppercase;letter-spacing:.12em;font-size:10px;font-weight:700;padding:15px 25px}.ad-btn.primary{background:#008ac1;color:#fff}.ad-btn.primary:hover{background:#006f9b}.ad-btn.outline{border:1px solid rgba(255,255,255,.3);color:#fff}.ad-btn.outline:hover{border-color:#2b9fe0;color:#2b9fe0}.ad-hero-strip{position:absolute;bottom:28px;left:0;right:0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.1)}.ad-hero-strip div{padding:15px 20px;background:rgba(2,7,17,.72);border-right:1px solid rgba(255,255,255,.08)}.ad-hero-strip small{display:block;color:#008ac1;font-size:9px;letter-spacing:.2em;margin-bottom:5px}.ad-hero-strip strong{font-size:11px;letter-spacing:.08em;text-transform:uppercase}
    .ad-light{background:#fff}.ad-challenge{padding:125px 0}.ad-split{display:grid;grid-template-columns:5fr 7fr;gap:80px}.ad-heading h2,.ad-designed h2,.ad-app-head h2,.ad-why h2{font-size:clamp(38px,5vw,72px);line-height:1.03;letter-spacing:-.03em;color:#295278;margin:25px 0 0}.ad-copy{padding-top:42px;border-left:2px solid rgba(0,138,193,.14);padding-left:50px}.ad-copy p{font-size:16px;line-height:1.8;color:#59636f}.ad-copy .lead{font-size:20px;color:#20252c}.ad-metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:40px}.ad-metrics div{padding:18px 12px;background:#f5f9fc;border:1px solid rgba(41,82,120,.1);font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:700;color:#295278}.ad-metrics i{display:block;width:6px;height:6px;border-radius:50%;background:#008ac1;margin-bottom:20px}
    .ad-dark{background:#061225;color:#fff}.ad-capabilities{padding:120px 0}.ad-intro-grid{display:grid;grid-template-columns:7fr 5fr;gap:70px;margin-bottom:55px}.ad-intro-grid h2{font-size:clamp(40px,5vw,76px);line-height:1.02;letter-spacing:-.03em;margin:24px 0;color:#fff}.ad-intro-grid p{color:rgba(255,255,255,.62);line-height:1.8;padding-top:40px}.ad-cap-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(79,160,220,.17)}.ad-cap{background:#07172d;min-height:245px;padding:30px}.ad-cap.large{grid-column:span 2}.ad-cap .icon{font-size:36px;color:#2b9fe0;height:52px}.ad-cap small{color:rgba(43,159,224,.65);letter-spacing:.2em}.ad-cap h3{font-size:18px;margin:10px 0;color:#fff}.ad-cap p{color:rgba(255,255,255,.53);font-size:14px;line-height:1.7}.ad-section-note{margin-top:24px;color:rgba(255,255,255,.5);font-size:11px;letter-spacing:.08em;display:flex;gap:10px;align-items:center}.ad-section-note i{width:22px;height:1px;background:#008ac1}
    .ad-designed{background:#f0f7fc;padding:120px 0}.ad-designed-head p{color:#59636f;line-height:1.8;padding-top:40px}.ad-attributes{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(41,82,120,.15);margin-top:55px}.ad-attributes>div{background:#fff;padding:30px;min-height:130px;display:flex;flex-direction:column;justify-content:space-between}.ad-attributes b{font-size:10px;color:#008ac1;letter-spacing:.15em}.ad-attributes strong{color:#295278;font-size:15px}.ad-attributes .featured{background:#07172d}.ad-attributes .featured strong{color:#fff}
    .ad-applications{padding:120px 0;background:#fff}.ad-app-head{display:grid;grid-template-columns:7fr 5fr;gap:70px;margin-bottom:55px}.ad-app-head p{color:#59636f;line-height:1.8;padding-top:40px}.ad-app-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#dce4eb}.ad-app-grid article{min-height:190px;background:#fff;padding:28px;position:relative;display:flex;flex-direction:column;justify-content:space-between}.ad-app-grid small{color:#008ac1;font-size:10px;letter-spacing:.2em}.ad-app-grid span{position:absolute;right:28px;top:25px;color:#9aa9bd}.ad-app-grid h3{font-size:19px;color:#295278;margin:0;max-width:230px}
    .ad-why{background:#061225;color:#fff;padding:120px 0;overflow:hidden}.ad-grid-overlay{position:absolute;inset:0;opacity:.3;background-image:linear-gradient(rgba(0,138,193,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(0,138,193,.08) 1px,transparent 1px);background-size:70px 70px}.ad-why-grid{position:relative;display:grid;grid-template-columns:7fr 5fr;gap:90px}.ad-why h2{color:#fff}.ad-why p{max-width:620px;color:rgba(255,255,255,.58);line-height:1.8;margin-top:28px}.ad-why-list{border-left:1px solid rgba(255,255,255,.12)}.ad-why-list div{padding:20px 0 20px 30px;border-bottom:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.75);font-size:14px}.ad-why-list small{color:#008ac1;margin-right:20px;letter-spacing:.12em}.ad-cta{background:#008ac1;color:#fff;padding:110px 0}.ad-cta small{font-size:10px;letter-spacing:.2em;text-transform:uppercase;opacity:.75}.ad-cta h2{font-size:clamp(42px,6vw,82px);line-height:.98;letter-spacing:-.03em;margin:20px 0}.ad-cta p{max-width:600px;color:rgba(255,255,255,.8);line-height:1.8;margin-bottom:32px}.ad-btn.dark{background:#020711;color:#fff}.ad-btn.dark:hover{background:#061225}
    @media(max-width:900px){.ad-split,.ad-intro-grid,.ad-app-head,.ad-why-grid{grid-template-columns:1fr;gap:35px}.ad-hero{min-height:760px}.ad-hero-content{padding-top:145px;padding-bottom:190px}.ad-cap-grid{grid-template-columns:repeat(2,1fr)}.ad-attributes{grid-template-columns:repeat(2,1fr)}.ad-app-grid{grid-template-columns:repeat(2,1fr)}.ad-metrics{grid-template-columns:repeat(3,1fr)}.ad-hero-strip{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:640px){.ad-container{width:min(100% - 32px,1180px)}.ad-hero h1{font-size:clamp(43px,13vw,65px)}.ad-hero p{font-size:14px}.ad-hero-angle{right:-25%;width:80%}.ad-hero-strip{bottom:16px}.ad-hero-strip div{padding:11px 12px}.ad-hero-strip strong{font-size:9px}.ad-challenge,.ad-capabilities,.ad-designed,.ad-applications,.ad-why{padding:80px 0}.ad-heading h2,.ad-designed h2,.ad-app-head h2,.ad-why h2{font-size:clamp(38px,11vw,56px)}.ad-metrics{grid-template-columns:repeat(2,1fr)}.ad-cap-grid,.ad-app-grid{grid-template-columns:1fr}.ad-cap.large{grid-column:span 1}.ad-attributes{grid-template-columns:1fr}.ad-copy{padding-left:22px}.ad-actions{flex-direction:column;align-items:stretch}.ad-btn{width:100%}}
  </style>
</BaseLayout>
