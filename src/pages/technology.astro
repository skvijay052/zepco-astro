--- 
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EngineerDrawer from '../components/EngineerDrawer.astro';
import FinalCTA from '../components/FinalCTA.astro';

const heroImage = '/images/our-story-banner.webp';
---

<BaseLayout
  title="Technologies That Power Tomorrow | Zepco Technologies"
  description="Advanced power electronics, electric propulsion and engineering services from Zepco Technologies."
>
  <Navbar />

  <main id="main-content" tabindex="-1" class="technology-page">
    <section class="tech-hero" aria-label="Zepco technology banner">
      <img src={heroImage} alt="Zepco engineers working on advanced power electronics and electric propulsion technology" />
      <div class="tech-hero-overlay"></div>
      <div class="tech-hero-content">
        <div class="container">
          <div class="hero-label"><span></span> Technologies</div>
          <h1>Engineering the technology<br />beneath the system —<br /><em>not just the component.</em></h1>
        </div>
      </div>
    </section>

    <section class="tech-intro" id="story">
      <div class="container story-grid">
        <div class="story-left">
          <div class="section-label">Technology Foundation</div>
          <h2>Technologies<br />that power<br /><em>tomorrow.</em></h2>
          <a class="text-link" href="#power">Explore our technology domains <b>→</b></a>
        </div>
        <div class="story-right">
          <p>The world's transition to electrification demands engineering that goes beyond individual components. At Zepco, technology is the engineering foundation that enables safer, smarter and more efficient systems — spanning advanced power electronics, electric propulsion, energy storage and systems engineering.</p>
          <p>Whether powering unmanned aerial systems, industrial automation, electric mobility or mission-critical platforms, we combine deep domain knowledge with practical engineering to deliver reliable, high-performance technology for demanding real-world applications. Explore our core technology domains below.</p>
          <div class="quote-box"><p>“Engineering the technology beneath the system — not just the component.”</p></div>
        </div>
      </div>
    </section>

    <section class="technology-grid-section" id="power">
      <div class="container">
        <div class="section-head">
          <div class="section-label">Section 01 / Core Technology</div>
          <h2>Advanced Power Electronics</h2>
          <p>Power electronics sits at the heart of every modern electric system. From efficient energy conversion to intelligent power management, our technologies enable reliable, high-performance operation across diverse applications.</p>
        </div>
        <div class="icon-card-grid">
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-acdc"></use></svg></div><div class="card-body"><h3>AC-DC Power Supplies</h3><p>Efficient, dependable conversion architectures for demanding systems.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-dcdc"></use></svg></div><div class="card-body"><h3>DC-DC Converters</h3><p>High-density regulated conversion for distributed power architectures.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-inverter"></use></svg></div><div class="card-body"><h3>DC-AC Inverters</h3><p>Controlled power delivery for motors, platforms and energy systems.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-rectifier"></use></svg></div><div class="card-body"><h3>Rectifiers</h3><p>Robust conversion stages designed for stable, efficient operation.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-programmable"></use></svg></div><div class="card-body"><h3>Programmable Power Supplies</h3><p>Flexible controlled power for development, validation and test.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-amplifier"></use></svg></div><div class="card-body"><h3>Power Amplifiers</h3><p>Purpose-built amplification for demanding electronic applications.</p></div></article>
        </div>
        <a class="section-cta" href="#contact">Explore Advanced Power Electronics <b>→</b></a>
      </div>
    </section>

    <section class="propulsion" id="propulsion">
      <div class="container">
        <div class="section-label">Section 02 / Core Technology</div>
        <h2>Electric Propulsion</h2>
        <p class="section-intro">Electric propulsion is transforming aerospace, unmanned systems and next-generation mobility. Zepco develops propulsion technologies that maximize efficiency, improve power density and deliver dependable performance under demanding operating conditions.</p>
        <div class="propulsion-grid">
          <article class="prop-card"><strong>01</strong><h3>Drone Motors</h3><p>High-performance motors engineered for responsive, efficient UAV propulsion.</p></article>
          <article class="prop-card"><strong>02</strong><h3>Electronic Speed Controllers</h3><p>Fast, precise motor control electronics for demanding electric platforms.</p></article>
          <article class="prop-card"><strong>03</strong><h3>Motor Controllers</h3><p>Control architectures balancing efficiency, response and reliability.</p></article>
          <article class="prop-card"><strong>04</strong><h3>Integrated Propulsion Systems</h3><p>Motor, controller and power technologies engineered as one system.</p></article>
          <article class="prop-card"><strong>05</strong><h3>Propulsion System Optimization</h3><p>Engineering-led optimization of power, efficiency, thermal behaviour and performance.</p></article>
        </div>
        <a class="section-cta light-cta" href="#contact">Explore Electric Propulsion <b>→</b></a>
      </div>
    </section>

    <section class="technology-grid-section services" id="services">
      <div class="container">
        <div class="section-head">
          <div class="section-label">Section 03 / Engineering Services</div>
          <h2>Engineering Services</h2>
          <p>Complex engineering challenges require more than off-the-shelf products. Our multidisciplinary team works closely with customers across the full development lifecycle, from concept and architecture through validation, manufacturing and lifecycle support.</p>
        </div>
        <div class="icon-card-grid service-grid">
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-architecture"></use></svg></div><div class="card-body"><h3>System Architecture</h3><p>Translate requirements into robust, scalable system architectures.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-hardware"></use></svg></div><div class="card-body"><h3>Hardware Design</h3><p>Design power and control electronics around real platform constraints.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-firmware"></use></svg></div><div class="card-body"><h3>Embedded Firmware</h3><p>Embedded software engineered for deterministic, dependable control.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-control"></use></svg></div><div class="card-body"><h3>Motor Control Algorithms</h3><p>Control strategies optimized for performance and efficiency.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-thermal"></use></svg></div><div class="card-body"><h3>Thermal &amp; Electromagnetic Design</h3><p>Design for thermal margins, EMI behaviour and system reliability.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-simulation"></use></svg></div><div class="card-body"><h3>Simulation &amp; Modelling</h3><p>Model system behaviour before hardware is committed.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-prototype"></use></svg></div><div class="card-body"><h3>Prototype Development</h3><p>Move from engineering concept to functional hardware.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-testing"></use></svg></div><div class="card-body"><h3>Validation &amp; Testing</h3><p>Verify performance against demanding technical requirements.</p></div></article>
          <article class="icon-card"><div class="card-top"><svg class="solid-icon" aria-hidden="true"><use href="#icon-manufacturing"></use></svg></div><div class="card-body"><h3>Manufacturing Support</h3><p>Support the transition from validated design to repeatable production.</p></div></article>
        </div>
        <a class="section-cta" href="#contact">Explore Engineering Services <b>→</b></a>
      </div>
    </section>

    <FinalCTA />
  </main>

  <Footer />
  <EngineerDrawer />

  <svg class="icon-sprite" aria-hidden="true" width="0" height="0" focusable="false">
    <symbol id="icon-acdc" viewBox="0 0 48 48"><path d="M7 10h14v28H7zM27 14h14v20H27z"/><path d="M21 18h6v4h-6zm0 8h6v4h-6z"/><path d="M12 17h4v14h-4z"/><path d="M31 19h6v4h-6zm0 6h6v4h-6z"/></symbol>
    <symbol id="icon-dcdc" viewBox="0 0 48 48"><path d="M5 12h38v24H5z"/><path d="M11 18h8v12h-8zm18 0h8v12h-8z"/><path d="M19 22h10v4H19z"/></symbol>
    <symbol id="icon-inverter" viewBox="0 0 48 48"><path d="M6 9h36v30H6z"/><path d="M12 31l7-14 6 9 5-7 6 12H12z"/><path d="M10 13h28v4H10z"/></symbol>
    <symbol id="icon-rectifier" viewBox="0 0 48 48"><path d="M7 10h34v28H7z"/><path d="M13 15h4v18h-4zm18 0h4v18h-4z"/><path d="M17 22h14v4H17z"/></symbol>
    <symbol id="icon-programmable" viewBox="0 0 48 48"><path d="M5 9h38v30H5z"/><path d="M11 14h17v20H11z"/><path d="M32 15h6v4h-6zm0 7h6v4h-6zm0 7h6v4h-6z"/><path d="M15 18h9v4h-9zm0 7h9v4h-9z"/></symbol>
    <symbol id="icon-amplifier" viewBox="0 0 48 48"><path d="M6 9h36v30H6z"/><path d="M12 24h8l5-10v20l-5-10h-8z"/><path d="M29 16h7v4h-7zm0 6h7v4h-7zm0 6h7v4h-7z"/></symbol>
    <symbol id="icon-architecture" viewBox="0 0 48 48"><path d="M7 7h14v14H7zM27 7h14v14H27zM7 27h14v14H7zM27 27h14v14H27z"/><path d="M21 13h6v4h-6zm-8 8v6h4v-6zm16 0v6h4v-6zM21 31h6v4h-6z"/></symbol>
    <symbol id="icon-hardware" viewBox="0 0 48 48"><path d="M12 12h24v24H12z"/><path d="M17 17h14v14H17z"/><path d="M20 20h8v8h-8z"/><path d="M6 16h6v4H6zm0 12h6v4H6zm30-12h6v4h-6zm0 12h6v4h-6zM16 6h4v6h-4zm12 0h4v6h-4zm-12 30h4v6h-4zm12 0h4v6h-4z"/></symbol>
    <symbol id="icon-firmware" viewBox="0 0 48 48"><path d="M12 8h24v32H12z"/><path d="M18 14h12v5H18zm0 9h12v5H18zm0 9h8v3h-8z"/><path d="M7 14h5v4H7zm0 8h5v4H7zm0 8h5v4H7zm29-16h5v4h-5zm0 8h5v4h-5zm0 8h5v4h-5z"/></symbol>
    <symbol id="icon-control" viewBox="0 0 48 48"><path d="M7 10h34v28H7z"/><path d="M13 17h22v4H13zm0 10h14v4H13z"/><circle cx="33" cy="19" r="4"/><circle cx="29" cy="29" r="4"/></symbol>
    <symbol id="icon-thermal" viewBox="0 0 48 48"><path d="M15 8h7v22a7 7 0 1 1-7 0z"/><circle cx="18.5" cy="34" r="4"/><path d="M29 12h13v4H29zm0 8h9v4h-9zm0 8h13v4H29z"/></symbol>
    <symbol id="icon-simulation" viewBox="0 0 48 48"><path d="M6 8h36v32H6z"/><path d="M12 32l7-8 5 4 10-13 4 4v9l-5-5-9 11-5-4-7 7z"/></symbol>
    <symbol id="icon-prototype" viewBox="0 0 48 48"><path d="M9 9h30v30H9z"/><path d="M15 15h18v18H15z"/><path d="M20 20h8v8h-8z"/><path d="M5 17h4v4H5zm0 10h4v4H5zm34-10h4v4h-4zm0 10h4v4h-4z"/></symbol>
    <symbol id="icon-testing" viewBox="0 0 48 48"><path d="M9 7h30v34H9z"/><path d="M14 14h20v4H14zm0 8h20v4H14zm0 8h12v4H14z"/><path d="M29 29l4 4 7-9-4-3z"/></symbol>
    <symbol id="icon-manufacturing" viewBox="0 0 48 48"><path d="M5 36h38v5H5zM8 31V17l10 7V13l10 7V10l12 8v13H8z"/><path d="M14 27h5v5h-5zm10 0h5v5h-5z"/></symbol>
  </svg>
</BaseLayout>

<style>
.technology-page{background:#fff;color:#111;overflow:hidden}.technology-page .container{width:min(1180px,calc(100% - 48px));margin:0 auto}.tech-hero{min-height:78vh;position:relative;display:flex;align-items:flex-end;overflow:hidden;background:#03091a;color:#fff}.tech-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.tech-hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,9,26,.90),rgba(3,9,26,.55) 48%,rgba(3,9,26,.12)),linear-gradient(0deg,rgba(3,9,26,.65),transparent 55%)}.tech-hero-content{position:relative;z-index:1;width:100%;padding:8.5rem 0 6rem}.hero-label,.section-label{display:flex;align-items:center;gap:12px;color:var(--color-gold-500);font-size:10px;letter-spacing:.3em;text-transform:uppercase;font-weight:600}.hero-label span{display:block;width:32px;height:1px;background:var(--color-gold-500)}.section-label::before{content:'';display:block;width:32px;height:1px;background:var(--color-gold-500);flex:0 0 32px}.tech-hero h1{max-width:950px;font-size:clamp(3rem,7.5vw,6.2rem);line-height:.95;letter-spacing:.02em;margin:22px 0 0;font-weight:700;text-transform:uppercase}.tech-hero h1 em{color:#4bb9ee;font-style:normal}.tech-intro{padding:88px 0 100px;background:#fff}.story-grid{display:grid;grid-template-columns:280px 1fr;gap:85px;align-items:start}.story-left h2{font-size:3rem;line-height:1.25;letter-spacing:.02em;margin:24px 0 0;font-weight:700;text-transform:uppercase;color:#03091a}.story-left h2 em{color:#078fc6;font-style:normal}.story-right{border-left:1px solid #eee2d5;padding-left:64px}.story-right p{color:#8b9bb4;font-size:14px;line-height:1.78;margin:0}.story-right p+p{margin-top:24px}.quote-box{margin-top:44px;background:#f7f7f7;border-left:3px solid #0098d2;padding:24px 25px}.quote-box p{font-style:italic;color:#12171d;font-size:13px}.text-link{margin-top:42px;display:inline-flex;align-items:center;gap:8px;color:#008dcc;font-size:9px;letter-spacing:.16em;text-transform:uppercase;text-decoration:none}.text-link b{font-size:16px;transition:transform .2s}.text-link:hover b{transform:translateX(4px)}
.technology-grid-section{padding:80px 0 95px;background:#fff}.section-head{margin-bottom:50px}.section-head .section-label{margin-bottom:24px}.section-head h2,.propulsion h2{font-size:3rem;line-height:1.25;letter-spacing:.02em;margin:0 0 18px;font-weight:700;text-transform:uppercase;color:#03091a}.section-head>p,.section-intro{max-width:930px;color:#8b9bb4;font-size:14px;line-height:1.75;margin:0}.icon-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #d8e4e9;border-left:1px solid #d8e4e9;width:100%}.icon-card{background:#fff;border-right:1px solid #d8e4e9;border-bottom:1px solid #d8e4e9;min-height:245px;padding:32px 30px 30px;transition:.28s;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start}.icon-card:hover{transform:translateY(-4px);box-shadow:0 18px 45px rgba(7,52,79,.09);z-index:2}.card-top{display:flex;align-items:center;min-height:48px;height:48px;margin-bottom:22px}.solid-icon{width:42px;height:42px;fill:#0798d1;color:#0798d1;display:block}.card-body h3{font-size:18px;line-height:1.25;margin:0 0 11px;font-weight:800}.card-body p{font-size:12px;line-height:1.65;color:#676d73;margin:0;max-width:330px}.section-cta{margin-top:34px;display:inline-flex;align-items:center;gap:14px;padding:15px 22px;background:#0798d1;color:#fff;border:1px solid #0798d1;box-shadow:0 10px 24px rgba(0,137,193,.18);font-size:9px;letter-spacing:.15em;text-transform:uppercase;text-decoration:none;transition:.25s}.section-cta:hover{background:#006f9d;border-color:#006f9d;color:#fff;transform:translateY(-2px);box-shadow:0 14px 28px rgba(0,111,157,.22)}.section-cta b{color:#fff;font-size:16px}.services{background:#fff}.services .icon-card-grid{background:#f8fafb}
.propulsion{padding:85px 0 95px;background:#f4f9fc}.propulsion h2{margin:24px 0 18px}.section-intro{margin:0 0 52px}.propulsion-grid{display:grid;grid-template-columns:repeat(5,1fr);background:#fff;border:1px solid #eee}.prop-card{min-height:315px;padding:30px 20px 27px;border-right:1px solid #eee;transition:.25s;display:flex;flex-direction:column}.prop-card:last-child{border-right:0}.prop-card:hover{background:#f8fbfd;transform:translateY(-3px)}.prop-card>strong{display:block;color:#f1e9d7;font-size:38px;line-height:1;font-weight:800;margin-bottom:42px;letter-spacing:-.04em}.prop-card h3{font-size:14px;line-height:1.35;text-transform:uppercase;margin:0 0 11px;font-weight:800}.prop-card p{font-size:11px;line-height:1.62;color:#777;margin:0}
@media(max-width:1050px){.story-grid{grid-template-columns:260px 1fr;gap:55px}.story-right{padding-left:42px}.propulsion-grid{grid-template-columns:repeat(3,1fr)}.prop-card:nth-child(3){border-right:0}.prop-card:nth-child(-n+3){border-bottom:1px solid #eee}.prop-card:nth-child(4){border-right:1px solid #eee}}
@media(max-width:900px){.story-grid{grid-template-columns:1fr;gap:42px}.story-right{padding-left:28px}.icon-card-grid{grid-template-columns:repeat(2,1fr)}.propulsion-grid{grid-template-columns:repeat(2,1fr)}.prop-card:nth-child(3){border-right:1px solid #eee}.prop-card:nth-child(2n){border-right:0}.prop-card:nth-child(3),.prop-card:nth-child(4){border-bottom:1px solid #eee}.prop-card:last-child{border-bottom:0}}
@media(max-width:600px){.technology-page .container{width:calc(100% - 36px)}.tech-hero{min-height:560px}.tech-hero>img{object-position:62% center}.tech-hero-overlay{background:linear-gradient(90deg,rgba(3,9,26,.76),rgba(3,9,26,.2) 75%),linear-gradient(0deg,rgba(3,9,26,.78),transparent 52%)}.tech-hero-content{padding:8rem 0 4.5rem}.tech-hero h1{font-size:clamp(2.8rem,12vw,5rem)}.tech-intro,.technology-grid-section,.propulsion{padding:58px 0 65px}.story-left h2,.section-head h2,.propulsion h2,.cta-content h2{font-size:clamp(38px,11vw,56px)}.section-head{margin-bottom:38px}.section-head>p,.section-intro{font-size:13px}.icon-card-grid,.propulsion-grid{grid-template-columns:1fr}.prop-card,.prop-card:nth-child(n){border-right:0;border-bottom:1px solid #eee;min-height:260px}.prop-card:last-child{border-bottom:0}.solid-icon{width:34px;height:34px}.cta-content h2{font-size:52px}.contact-cta{min-height:480px}.cta-content p{padding:0 20px}}
html[data-theme='dark'] .technology-page{background:#03091a;color:#fff}html[data-theme='dark'] .story-left h2,html[data-theme='dark'] .section-head h2,html[data-theme='dark'] .propulsion h2{color:#fff}html[data-theme='dark'] .tech-intro,html[data-theme='dark'] .technology-grid-section,html[data-theme='dark'] .services{background:#03091a}html[data-theme='dark'] .story-right{border-left-color:rgba(196,154,46,.18)}html[data-theme='dark'] .story-right p,html[data-theme='dark'] .section-head>p,html[data-theme='dark'] .section-intro,html[data-theme='dark'] .card-body p,html[data-theme='dark'] .prop-card p{color:#aeb8c8}html[data-theme='dark'] .quote-box{background:#0c1b38}html[data-theme='dark'] .quote-box p{color:#fff}html[data-theme='dark'] .icon-card-grid{border-color:#29405b}html[data-theme='dark'] .icon-card{background:#071a2b;border-color:#29405b}html[data-theme='dark'] .propulsion{background:#071a2b}html[data-theme='dark'] .propulsion-grid{background:#071a2b;border-color:#29405b}html[data-theme='dark'] .prop-card{border-color:#29405b}html[data-theme='dark'] .prop-card:hover{background:#0c1b38}
</style>