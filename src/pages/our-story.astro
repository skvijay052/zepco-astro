---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Link from '../components/Link.astro';
import Icon from '../components/Icon.astro';
import EngineerDrawer from '../components/EngineerDrawer.astro';

const storyBanner = '/images/our-story-banner.webp';
const imageTwo = 'https://zepco-astro.vercel.app/images/engineering-compromise.png';
---

<BaseLayout
  title="Our Story | Zepco Technologies"
  description="The story of Zepco Technologies — built on conviction, driven by people, and focused on solving hard power electronics and electric propulsion challenges."
>
  <Navbar />

  <main id="top" class="our-story-page">
    <section class="story-hero" data-reveal>
      <img src={storyBanner} alt="Engineers working together on advanced technology" />
      <div class="hero-overlay"></div>
      <div class="hero-grid"></div>
      <div class="story-container hero-inner">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> Our Story</div>
          <h1>Built on<br />Conviction.<br /><em>Driven by People.</em></h1>
          <p>From a small apartment in Bengaluru to a multidisciplinary engineering company, our journey has always been about one thing — solving hard problems, together.</p>
        </div>
      </div>
      <div class="hero-scroll">Scroll <span></span></div>
    </section>

    <section class="story-section section-white" id="story" data-reveal>
      <div class="story-container two-column">
        <div class="section-heading">
          <div class="section-kicker">01 <i></i> A Conviction</div>
          <h2>A conviction<br />became <em>Zepco.</em></h2>
        </div>
        <div class="section-content">
          <p class="large-copy">In 2022, Zepco started with three people working out of a two-bedroom apartment in Bengaluru.</p>
          <p>We didn't begin with a large office, a manufacturing facility or a long customer list.</p>
          <p>What we had was a conviction: that the future would belong to technologies powered by advanced power electronics and electric propulsion, and that those technologies deserved uncompromising engineering. That conviction became Zepco.</p>
        </div>
      </div>
    </section>

    <section class="story-section section-blue" data-reveal>
      <div class="story-container people-grid">
        <div class="people-image"><img src={imageTwo} alt="Engineers collaborating on electronics" loading="lazy" decoding="async" /></div>
        <div class="section-content">
          <div class="section-kicker light">02 <i></i> More Than Technology</div>
          <h2>More Than<br />Technology</h2>
          <p>Technology was only one part of the vision. The other was people. We set out to build a company where young engineers could work alongside industry veterans with decades of experience designing, developing and commercialising world-class power electronics and propulsion systems.</p>
          <p>Our belief was simple: knowledge should not retire, it should be transferred. Every design review, prototype, customer interaction and engineering challenge became an opportunity to pass knowledge to the next generation — a culture that still defines Zepco today.</p>
          <div class="people-callout"><span class="callout-icon">↗</span><span>Experience meets<br />tomorrow.</span></div>
        </div>
      </div>
    </section>

    <section class="story-section section-white compromise-section" data-reveal>
      <div class="story-container two-column compromise-grid">
        <div class="section-content">
          <div class="section-kicker">03 <i></i> Engineering Without Compromise</div>
          <h2>Harder problems.<br /><em>Better solutions.</em></h2>
          <p>From day one, we chose to work on difficult engineering problems — the kind where efficiency, thermal performance, power density, control and reliability are constantly challenged.</p>
          <p>Rather than build products for their own sake, we engineer solutions that perform in demanding real-world environments.</p>
          <p>Every project begins with understanding the problem. Every solution is validated with discipline. Every partnership is built for the long term.</p>
          <div class="principles">
            <div><b>01</b><span>Understand<br />the problem</span></div>
            <div><b>02</b><span>Validate<br />with discipline</span></div>
            <div><b>03</b><span>Build for<br />the long term</span></div>
          </div>
        </div>
        <figure class="feature-image">
          <img src={imageTwo} alt="Engineer working with an electronics prototype" loading="lazy" decoding="async" />
          <figcaption><span>Engineering in practice</span><strong>Knowledge transferred.<br />Problems solved.</strong></figcaption>
        </figure>
      </div>
    </section>

    <section class="today-section" data-reveal>
      <div class="today-image"><img src={imageTwo} alt="Zepco engineering work" loading="lazy" decoding="async" /><div class="today-image-overlay"></div></div>
      <div class="today-content">
        <div class="section-kicker light">04 <i></i> Zepco Today</div>
        <h2>Zepco Today</h2>
        <p class="large-copy">From a small apartment in Bengaluru, Zepco has grown into a multidisciplinary engineering company serving aerospace, defence, industrial and mobility customers.</p>
        <p>Today we bring together 300+ years of combined leadership experience, 45+ design engineers, end-to-end engineering from concept to manufacturing, deep expertise in power electronics and electric propulsion, and long-term partnerships with customers developing mission-critical systems.</p>
        <div class="stats">
          <div><strong>300+</strong><span>years of combined<br />leadership experience</span></div>
          <div><strong>45+</strong><span>design<br />engineers</span></div>
          <div><strong>360°</strong><span>concept-to-manufacturing<br />engineering</span></div>
          <div><strong>5</strong><span>core<br />industries</span></div>
        </div>
      </div>
    </section>

    <section class="future-section" data-reveal>
      <div class="future-shape shape-one"></div><div class="future-shape shape-two"></div>
      <div class="story-container future-grid">
        <div class="section-content">
          <div class="section-kicker">05 <i></i> Looking Ahead</div>
          <h2>The work<br /><em>moves forward.</em></h2>
          <p>The boundaries of physics haven't stopped moving. Neither have we. As electrification reshapes industries worldwide, Zepco remains committed to solving increasingly complex engineering challenges while preparing the next generation of engineers to carry that mission forward.</p>
          <p>We are not building products alone — we are building the engineering capability that will power the technologies of tomorrow.</p>
        </div>
        <div class="future-visual"><div class="future-sun"></div><div class="future-horizon"></div><div class="future-person"></div><div class="future-label">Same mission.<br />Bigger horizons.</div></div>
      </div>
    </section>

    <section class="story-cta" data-reveal>
      <div class="story-container text-center">
        <div class="section-kicker center light"><i></i> The Next Chapter <i></i></div>
        <h2>Let's build<br /><em>what's next.</em></h2>
        <p>Have a demanding power, propulsion or electrification challenge? Let's talk about the engineering behind it.</p>
        <Link href="/#contact" class="cta-button">Start a Conversation <Icon class="w-4 h-4" /></Link>
      </div>
    </section>
  </main>

  <Footer />
  <EngineerDrawer />
</BaseLayout>

<style>
  .our-story-page{background:#fff;color:#111;overflow:hidden}
  .story-container{width:min(1180px,calc(100% - 48px));margin:0 auto}
  .story-hero{min-height:88vh;position:relative;display:flex;align-items:center;background:#03091a;color:#fff;overflow:hidden}
  .story-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:.58;animation:story-bg-drift 24s ease-in-out infinite alternate;transform-origin:center center}
  @keyframes story-bg-drift{from{transform:scale(1.03) translate3d(-1%, -0.5%, 0)}to{transform:scale(1.09) translate3d(1%, 0.5%, 0)}}
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,9,26,.96),rgba(3,9,26,.68) 50%,rgba(3,9,26,.24)),linear-gradient(0deg,#03091a 0,transparent 30%)}
  .hero-grid{position:absolute;inset:0;opacity:.18;background-image:linear-gradient(rgba(196,154,46,.2) 1px,transparent 1px),linear-gradient(90deg,rgba(196,154,46,.2) 1px,transparent 1px);background-size:80px 80px;mask-image:linear-gradient(to bottom,transparent,#000 20%,transparent 90%)}
  .hero-inner{position:relative;z-index:2;padding:9rem 0 7rem}.hero-copy{max-width:780px}.eyebrow,.section-kicker{display:flex;align-items:center;gap:12px;color:#c49a2e;font-size:10px;letter-spacing:.25em;text-transform:uppercase;font-weight:600}.eyebrow span,.section-kicker i{display:block;width:32px;height:1px;background:#c49a2e}.hero-copy h1{font-size:clamp(3.4rem,7vw,7.2rem);line-height:.9;letter-spacing:-.02em;text-transform:uppercase;margin:24px 0}.hero-copy h1 em,h2 em{font-style:normal;color:#c49a2e}.hero-copy p{max-width:650px;color:#b7c1d0;font-size:1.05rem;line-height:1.8;font-weight:300}.hero-scroll{position:absolute;right:32px;bottom:38px;z-index:2;color:rgba(255,255,255,.55);font-size:9px;letter-spacing:.25em;text-transform:uppercase;display:flex;align-items:center;gap:12px;writing-mode:vertical-rl}.hero-scroll span{width:1px;height:48px;background:#c49a2e}
  .story-section{padding:8rem 0}.section-white{background:#fff}.section-blue{background:#071a2b;color:#fff}.two-column{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px;align-items:start}.section-heading h2,.section-content h2,.today-content h2,.future-section h2,.story-cta h2{font-size:clamp(2.8rem,5vw,5rem);line-height:.95;letter-spacing:-.02em;text-transform:uppercase;margin:22px 0 34px}.section-content p{max-width:680px;color:#5f5f5f;font-size:1rem;line-height:1.85;font-weight:300;margin:0 0 20px}.section-content .large-copy{font-size:1.25rem;line-height:1.7;color:#1f1f1f}.section-blue .section-content p{color:rgba(255,255,255,.67)}.section-blue .section-content .large-copy{color:#fff}.section-kicker.light{color:#d4a93a}
  .people-grid{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:center}.people-image{height:510px;overflow:hidden}.people-image picture{display:block;width:100%;height:100%}.people-image img{display:block;width:100%;height:100%;object-fit:cover}.people-callout{display:flex;align-items:center;gap:18px;margin-top:31px;padding-top:23px;border-top:1px solid rgba(191,211,223,.35);color:#8cc7ed;font-size:11px;line-height:1.45;text-transform:uppercase;letter-spacing:.08em}.callout-icon{width:36px;height:36px;border:1px solid #8cc7ed;border-radius:50%;display:grid;place-items:center;font-size:15px}
  .compromise-grid{align-items:stretch}.feature-image{position:relative;height:620px;margin:0;overflow:hidden;background:#061827;clip-path:polygon(9% 0,100% 0,100% 100%,0 100%)}.feature-image picture{display:block;width:100%;height:100%}.feature-image img{display:block;width:100%;height:100%;object-fit:cover}.feature-image:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,17,28,.78),rgba(3,17,28,.12) 52%,rgba(3,17,28,.05)),linear-gradient(0deg,rgba(3,17,28,.2),transparent)}.feature-image figcaption{position:absolute;z-index:2;left:13%;bottom:38px;color:#fff;text-transform:uppercase;letter-spacing:.08em}.feature-image figcaption span{display:block;color:rgba(255,255,255,.62);font-size:10px;margin-bottom:10px}.feature-image figcaption strong{font-size:14px;line-height:1.55}.principles{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ddd;margin-top:34px;padding-top:22px;gap:20px}.principles div{display:flex;gap:9px;align-items:flex-start;font-size:10px;line-height:1.45;text-transform:uppercase;letter-spacing:.06em}.principles b{color:#9b7620}
  .today-section{display:grid;grid-template-columns:1fr 1fr;min-height:620px;background:#03091a;color:#fff}.today-image{position:relative;min-height:620px;overflow:hidden}.today-image picture{display:block;width:100%;height:100%}.today-image img{display:block;width:100%;height:100%;object-fit:cover}.today-image-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,16,28,.02),rgba(3,16,28,.8))}.today-content{padding:86px max(42px,6vw) 80px 70px;display:flex;flex-direction:column;justify-content:center}.today-content p{color:rgba(255,255,255,.66)}.today-content .large-copy{color:#fff}.stats{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid rgba(196,154,46,.2);margin-top:28px;padding-top:26px;gap:28px 35px}.stats div{display:flex;flex-direction:column}.stats strong{color:#63bcff;font-size:43px;line-height:1;letter-spacing:-.055em;font-weight:500}.stats span{margin-top:8px;color:rgba(255,255,255,.58);font-size:10px;line-height:1.45;text-transform:uppercase;letter-spacing:.06em}
  .future-section{position:relative;overflow:hidden;padding:120px 0;background:linear-gradient(120deg,#eef6fa,#f8fbfc 52%,#d8e8f0)}.future-grid{position:relative;z-index:2;display:grid;grid-template-columns:.9fr 1.1fr;gap:75px;align-items:center}.future-section .section-content p{color:#4f6572}.future-visual{position:relative;height:390px;overflow:hidden;background:linear-gradient(160deg,#c0d9e6,#7b98a8 54%,#324e5e)}.future-sun{position:absolute;width:85px;height:85px;border-radius:50%;right:20%;top:16%;background:#f6d99e;box-shadow:0 0 70px 24px rgba(246,217,158,.4)}.future-horizon{position:absolute;left:-8%;right:-8%;bottom:-10%;height:66%;background:#334f5e;clip-path:polygon(0 100%,18% 57%,34% 73%,48% 39%,63% 65%,78% 43%,100% 75%,100% 100%)}.future-person{position:absolute;left:48%;bottom:16%;width:50px;height:130px;background:#172c3a;border-radius:45% 45% 10% 10%}.future-person:before{content:'';position:absolute;top:-30px;left:8px;width:34px;height:34px;border-radius:50%;background:#172c3a}.future-label{position:absolute;right:8%;bottom:9%;color:#fff;font-size:10px;line-height:1.5;text-transform:uppercase;letter-spacing:.1em}
  .story-cta{padding:120px 0;background:#03091a;color:#fff;text-align:center}.story-cta .center{justify-content:center}.story-cta p{max-width:560px;margin:0 auto 32px;color:#8b9bb4;line-height:1.7}.cta-button{display:inline-flex;align-items:center;gap:10px;background:#c49a2e;color:#03091a;padding:15px 22px;text-transform:uppercase;letter-spacing:.08em;font-size:10px;font-weight:700}.cta-button:hover{background:#d4a93a}
  @media(max-width:1599px) and (min-width:901px){.hero-copy h1{font-size:clamp(3.2rem,6.5vw,6rem)}}
  @media(prefers-reduced-motion:reduce){.story-hero>img{animation:none}}
  @media(max-width:900px){.two-column,.people-grid,.future-grid,.today-section{grid-template-columns:1fr}.story-container{width:min(100% - 32px,720px)}.story-section{padding:5rem 0}.hero-inner{padding:8rem 0 5rem}.hero-copy h1{font-size:clamp(3rem,14vw,5rem)}.people-image,.feature-image,.today-image{height:420px;min-height:420px}.today-content{padding:70px 32px}.feature-image{clip-path:none}.future-section{padding:80px 0}.future-visual{height:320px}.hero-scroll{display:none}}
  @media(max-width:560px){.story-container{width:calc(100% - 28px)}.hero-copy p{font-size:.95rem}.section-heading h2,.section-content h2,.today-content h2,.future-section h2,.story-cta h2{font-size:2.65rem}.people-image,.feature-image,.today-image{height:330px;min-height:330px}.stats{grid-template-columns:1fr 1fr}.stats strong{font-size:34px}.principles{grid-template-columns:1fr}.future-visual{height:270px}.story-cta{padding:90px 0}}
</style>
