---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import Industries from '../components/Industries.astro';
import Capabilities from '../components/Capabilities.astro';
import WhyTrust from '../components/WhyTrust.astro';
import FeaturedSolutions from '../components/FeaturedSolutions.astro';
import EngineeringStories from '../components/EngineeringStories.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import EngineerDrawer from '../components/EngineerDrawer.astro';
---
<BaseLayout>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <WhoWeAre />
    <Industries />
    <Capabilities />
    <WhyTrust />
    <FeaturedSolutions />
    <EngineeringStories />
    <FinalCTA />
  </main>
  <Footer />
  <EngineerDrawer />

  <script>
    const updateHomepageHeadings = () => {
      const updates = [
        { section: '#industries', label: 'Industries We Serve', heading: 'Engineering that Powers Progress' },
        { section: '#capabilities', label: 'Engineering Capabilities', heading: 'Deep Engineering Across the Power Electronics Stack' },
        { section: '#trust', label: 'Why Customers Trust Zepco', heading: 'Built on Engineering. Proven Through Execution.' },
        { section: '#solutions', label: 'Featured Solutions', heading: 'Solutions that Power Innovation' },
        { section: '#stories', label: 'Engineering Stories', heading: 'Proof, Not Promises' },
      ];

      updates.forEach(({ section, label, heading }) => {
        const root = document.querySelector(section);
        if (!root) return;

        const labelEl = root.querySelector('.flex.items-center.gap-3.mb-4 span');
        const headingEl = root.querySelector('h2');

        if (labelEl) labelEl.textContent = label;
        if (headingEl) {
          headingEl.textContent = heading;
          headingEl.classList.remove('uppercase');
          headingEl.style.textTransform = 'none';
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateHomepageHeadings, { once: true });
    } else {
      updateHomepageHeadings();
    }
  </script>

  <style is:global>
    /* Hide the secondary/right-side heading text on the homepage sections. */
    #industries > div.relative > div.flex.flex-col > p,
    #capabilities > div > div.flex.flex-col > p,
    #trust > div > div.grid > div:last-child > p:first-child,
    #solutions > div > div.flex.flex-col > p,
    #stories > div > div.flex.flex-col > a {
      display: none !important;
    }
  </style>
</BaseLayout>
