---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import Industries from '../components/Industries.astro';
import Capabilities from '../components/Capabilities.astro';
import WhyTrust from '../components/WhyTrust.astro';
import FeaturedSolutions from '../components/FeaturedSolutions.astro';
import EngineeringStories from '../components/EngineeringStories.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import EngineerDrawer from '../components/EngineerDrawer.astro';
---
<BaseLayout>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <WhoWeAre />
    <Industries />
    <Capabilities />
    <WhyTrust />
    <FeaturedSolutions />
    <EngineeringStories />
    <FinalCTA />
  </main>
  <Footer />
  <EngineerDrawer />
</BaseLayout>
