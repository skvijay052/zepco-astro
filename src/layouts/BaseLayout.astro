---
import '../styles/global.css';
import { site } from '../data/site';
import EngineerDrawer from '../components/EngineerDrawer.astro';
interface Props { title?: string; description?: string; }
const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>
      try {
        const stored = localStorage.getItem('zepco-theme');
        if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <EngineerDrawer />
  </body>
</html>
