---
import '../styles/global.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string; }
const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="/our-story-dark.css" />
    <link rel="stylesheet" href="/inner-banners.css" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('zepco-theme');
        if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
    <title>{title}</title>
  </head>

    <style is:global>
      .section-about > div h2,
      .section-industries > div h2,
      .section-capabilities > div h2,
      .section-trust > div h2,
      .section-solutions > div h2,
      .section-stories > div h2,
      .section-contact h2,
      .our-story-page .section-heading h2,
      .our-story-page .section-content h2,
      .our-story-page .today-content h2,
      .our-story-page .future-section h2,
      .our-story-page .story-cta h2,
      .contact-page .contact-form-card h2,
      .contact-page .contact-details h2,
      .contact-page .map-heading h2,
      .contact-page .contact-bottom h2 {
        text-transform: none !important;
      }

      /* Blogs and Media: use the same clean light-mode treatment as the other homepage sections. */
      html[data-theme="light"] #blogs,
      html[data-theme="light"] #media {
        color: #111827 !important;
      }
      html[data-theme="light"] #blogs {
        background: #ffffff !important;
      }
      html[data-theme="light"] #media {
        background: #f7f8fa !important;
      }
      html[data-theme="light"] #blogs h2,
      html[data-theme="light"] #media h2,
      html[data-theme="light"] #media h3 {
        color: #111827 !important;
      }
      
      html[data-theme="light"] #blogs h3
      html[data-theme="light"] #media h3 {
        color: #ffffff !important;
      }
      html[data-theme="light"] #blogs > div > .grid {
        background: rgba(17,24,39,.12) !important;
      }
      html[data-theme="light"] #blogs > div > .grid > a > div:nth-child(2) {
        background: linear-gradient(to top, rgba(255,255,255,.96) 0%, rgba(255,255,255,.34) 62%, transparent 100%) !important;
      }
      html[data-theme="light"] #blogs > div > .grid > a img {
        filter: brightness(.72) saturate(.55) !important;
      }
      html[data-theme="light"] #media > div > .grid > a > div:first-child {
        background: #e9edf2 !important;
      }
      html[data-theme="light"] #media > div > .grid > a img {
        filter: brightness(.72) saturate(.55) !important;
      }
      html[data-theme="light"] #media > div > .grid > a .text-\[10px\] {
        color: rgba(138,106,28,.85) !important;
      }
      html[data-theme="light"] #media > div > .grid > a > div.pt-2 h3 {
        color: #111827 !important;
      }

      [data-reveal] { opacity: 0; transform: translate3d(0, 28px, 0); transition: opacity .7s ease, transform .7s cubic-bezier(.22,1,.36,1); }
      [data-reveal="left"] { transform: translate3d(-32px, 0, 0); }
      [data-reveal="right"] { transform: translate3d(32px, 0, 0); }
      [data-reveal="scale"] { transform: scale(.96); }
      [data-reveal].is-visible { opacity: 1; transform: none; }
      [data-reveal][data-delay="1"] { transition-delay: .08s; }
      [data-reveal][data-delay="2"] { transition-delay: .16s; }
      [data-reveal][data-delay="3"] { transition-delay: .24s; }
      [data-reveal][data-delay="4"] { transition-delay: .32s; }
      [data-reveal] h1, [data-reveal] h2, [data-reveal] h3, [data-reveal] p, [data-reveal] a, [data-reveal] li, [data-reveal] button,
      [data-reveal] > h1, [data-reveal] > h2, [data-reveal] > h3, [data-reveal] > p,
      [data-reveal] > div > h1, [data-reveal] > div > h2, [data-reveal] > div > h3,
      [data-reveal] > div > p, [data-reveal] > div > .eyebrow, [data-reveal] > div > .section-label,
      [data-reveal] > div > a, [data-reveal] > div > nav, [data-reveal] > div > article {
        opacity: 0;
        transform: translate3d(0, 18px, 0);
        transition: opacity .65s ease, transform .65s cubic-bezier(.22,1,.36,1);
      }
      [data-reveal].is-visible h1, [data-reveal].is-visible h2, [data-reveal].is-visible h3,
      [data-reveal].is-visible p, [data-reveal].is-visible a, [data-reveal].is-visible li, [data-reveal].is-visible button,
      [data-reveal].is-visible > h1, [data-reveal].is-visible > h2, [data-reveal].is-visible > h3,
      [data-reveal].is-visible > p, [data-reveal].is-visible > div > h1, [data-reveal].is-visible > div > h2,
      [data-reveal].is-visible > div > h3, [data-reveal].is-visible > div > p, [data-reveal].is-visible > div > .eyebrow,
      [data-reveal].is-visible > div > .section-label, [data-reveal].is-visible > div > a,
      [data-reveal].is-visible > div > nav, [data-reveal].is-visible > div > article {
        opacity: 1;
        transform: none;
      }
      [data-reveal].is-visible > div > article:nth-child(2) { transition-delay: .08s; }
      [data-reveal].is-visible > div > article:nth-child(3) { transition-delay: .16s; }
      [data-reveal].is-visible > div > article:nth-child(4) { transition-delay: .24s; }
      [data-reveal].is-visible > div > article:nth-child(5) { transition-delay: .32s; }
      [data-reveal].is-visible > div > article:nth-child(6) { transition-delay: .4s; }
      @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1; transform: none; transition: none; } }
    </style>
    <script is:inline>
      (() => {
        const initReveal = () => {
          const items = Array.from(document.querySelectorAll('[data-reveal]'));
          if (!items.length) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            items.forEach((item) => item.classList.add('is-visible'));
            return;
          }
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
          items.forEach((item) => observer.observe(item));
        };
        document.addEventListener('DOMContentLoaded', initReveal, { once: true });
      })();
    </script>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
